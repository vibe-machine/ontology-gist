put $r94 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ScheduledEvent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ScheduledEvent",
  has typeLabel "ScheduledEvent",
  has kind "entity",
  has prefLabel "Scheduled Event",
  has definition "An event with a planned start datetime.",
  has scopeNote "If the event already started, but has not yet ended, it is a contemporary event with an actual start datetime. If the event is over, it is a historical event having an actual end datetime. The event always retains its planned start datetime, and thus continues to be a scheduled event.";
put (resource: $r94, module: $gist_core) isa inModule;

put $r95 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ScheduledTask",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ScheduledTask",
  has typeLabel "ScheduledTask",
  has kind "entity",
  has prefLabel "Scheduled Task",
  has definition "A task with a planned start datetime.",
  has scopeNote "If work on the task has already started, but has not yet ended, it will have an actual start datetime. If the task is completed, it will also have an actual end datetime. The task always retains its planned start time, and thus continues to be a scheduled task.";
put (resource: $r95, module: $gist_core) isa inModule;
