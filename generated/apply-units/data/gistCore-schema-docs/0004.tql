  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isProducedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isProducedBy",
  has typeLabel "isProducedBy",
  has kind "relation",
  has prefLabel "is produced by",
  has definition "Relates something to the thing that created, composed, or brought it into existence.",
  has example "A deliverable is produces by a task.",
  has example "A measurement is produced by a sensor.",
  has example "A painting is produced by a person.";
put (resource: $r158, module: $gist_core) isa inModule;

put $r159 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isRecognizedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isRecognizedBy",
  has typeLabel "isRecognizedBy",
  has kind "relation",
  has prefLabel "is recognized by",
  has definition "Relates something to a party that formally acknowledges its existence, validity, or legality.",
  has example "The existence of a particular company is recognized by the state.";
put (resource: $r159, module: $gist_core) isa inModule;

put $r160 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isRenderedOn",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isRenderedOn",
  has typeLabel "isRenderedOn",
  has kind "relation",
  has prefLabel "is rendered on",
  has definition "Relates content to the media on which it is rendered.",
  has example "A document is rendered on a computer screen; a piece of music is rendered through speakers.";
put (resource: $r160, module: $gist_core) isa inModule;

put $r161 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isTriggeredBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isTriggeredBy",
  has typeLabel "isTriggeredBy",
  has kind "relation",
  has prefLabel "is triggered by",
  has definition "Relates a contingency, such as an event or obligation, to the event that gives rise to it.",
  has scopeNote "For obligations, this property describes what must happen to trigger the contingent obligation. Other uses include controls, processes, etc.",
  has example "Fire insurance is contingent on a particular building burning down; the death benefit payout on a life insurance policy is contingent on the death of the insured person.";
put (resource: $r161, module: $gist_core) isa inModule;

put $r162 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isUnderJurisdictionOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isUnderJurisdictionOf",
  has typeLabel "isUnderJurisdictionOf",
  has kind "relation",
  has prefLabel "is under jurisdiction of",
  has definition "Relates a law, contract, etc., to the system of law or government which has the power, right, or authority to interpret and apply it.";
put (resource: $r162, module: $gist_core) isa inModule;

