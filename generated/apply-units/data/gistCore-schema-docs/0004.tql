put $gist_core isa SchemaModule,
  has moduleKey "gist-core",
  has moduleName "gistCore",
  has moduleKind "gist-core";

put $r147 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy",
  has typeLabel "isCategorizedBy",
  has kind "relation",
  has prefLabel "is categorized by",
  has definition "Relates something to a taxonomy term or other less formally defined classification.";
put (resource: $r147, module: $gist_core) isa inModule;

put $r148 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isConnectedTo",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isConnectedTo",
  has typeLabel "isConnectedTo",
  has kind "relation",
  has prefLabel "is connected to",
  has definition "A non-owning, non-causal, non-subordinate (i.e., peer-to-peer) relationship.";
put (resource: $r148, module: $gist_core) isa inModule;

put $r149 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf",
  has typeLabel "isDirectPartOf",
  has kind "relation",
  has prefLabel "is direct part of",
  has definition "The relationship between a part and a whole where the part has independent existence and there are no other parts in between.",
  has scopeNote "Because the part has independent existence, there is no cascading delete.",
  has scopeNote "It is safest to use this property when semantic directness is inherent in the relationship, rather than simply expressing a chosen granularity. For example, a spark plug is a direct part of an engine block; there cannot be any intermediate parts. Otherwise, there is a risk of making an isDirectPartOf assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:isPartOf.";
put (resource: $r149, module: $gist_core) isa inModule;

put $r150 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isExpressedIn",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isExpressedIn",
  has typeLabel "isExpressedIn",
  has kind "relation",
  has prefLabel "is expressed in",
  has definition "Relates something to the language it is expressed in.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Text";
put (resource: $r150, module: $gist_core) isa inModule;

put $r151 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isFirstMemberOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isFirstMemberOf",
  has typeLabel "isFirstMemberOf",
  has kind "relation",
  has prefLabel "is first member of",
  has definition "Relates the first member of an ordered collection to the collection.",
  has scopeNote "Given the Open World Assumption, the absence of a predecessor does not entail that an ordered member is the first member of an ordered collection. This property is used to explicitly indicate the first member. Since ordered collections need not be strictly ordered, there can be more than one first member.";
put (resource: $r151, module: $gist_core) isa inModule;

put $r152 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isGeoContainedIn",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isGeoContainedIn",
  has typeLabel "isGeoContainedIn",
  has kind "relation",
  has prefLabel "is geographically contained in",
  has definition "Relates one geographic location to another that contains it.";
put (resource: $r152, module: $gist_core) isa inModule;

put $r153 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy",
  has typeLabel "isGovernedBy",
  has kind "relation",
  has prefLabel "is governed by",
  has definition "Relates an entity to another entity that controls, directs, determines or has a guiding influence or authority over it.",
  has example "A country geographic region is governed by a country government; the installation and use of software is governed by a license.";
put (resource: $r153, module: $gist_core) isa inModule;

put $r154 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isIdentifiedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isIdentifiedBy",
  has typeLabel "isIdentifiedBy",
  has kind "relation",
  has prefLabel "is identified by",
  has definition "Relates something to a content object that uniquely identifies it.",
  has scopeNote "This is like a URI: a thing can have more than one ID, but each ID can refer to only one thing. Note that it is possible to have two IDs with the same text that refer to different things.";
put (resource: $r154, module: $gist_core) isa inModule;

put $r155 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isMadeUpOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isMadeUpOf",
  has typeLabel "isMadeUpOf",
  has kind "relation",
  has prefLabel "is made up of",
  has definition "Relates something to a substance that it is made up of.",
  has example "A vase is made of clay; water is made up of hydrogen and oxygen.";
put (resource: $r155, module: $gist_core) isa inModule;

put $r156 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf",
  has typeLabel "isMemberOf",
  has kind "relation",
  has prefLabel "is member of",
  has definition "Relates a member individual to the thing, such as a collection or organization, that it is a member of.";
put (resource: $r156, module: $gist_core) isa inModule;

put $r157 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isPartOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isPartOf",
  has typeLabel "isPartOf",
  has kind "relation",
  has prefLabel "is part of",
  has definition "The relationship between a part and a whole where the part has independent existence.",
  has scopeNote "Because the part has independent existence, there is no cascading delete.",
  has scopeNote "The transitive version of gist:isDirectPartOf.";
put (resource: $r157, module: $gist_core) isa inModule;

