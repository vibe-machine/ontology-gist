  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Requirement",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Requirement",
  has typeLabel "Requirement",
  has kind "entity",
  has prefLabel "Requirement",
