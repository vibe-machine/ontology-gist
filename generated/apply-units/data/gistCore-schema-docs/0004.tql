  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualStartMinute",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualStartMinute",
  has typeLabel "actualStartMinute",
  has kind "attribute",
  has prefLabel "actual start minute",
  has definition "The actual date and time that something started, with precision of one minute.",
  has scopeNote "Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.",
  has example "'2021-06-01T08:32:00-6:00'^^xsd:dateTime";
put (resource: $r184, module: $gist_core) isa inModule;

put $r185 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualStartYear",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualStartYear",
  has typeLabel "actualStartYear",
  has kind "attribute",
  has prefLabel "actual start year",
  has definition "The actual date that something started, with precision of one year.",
  has scopeNote "Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.",
  has example "'2021-01-01T00:00:00-6:00'^^xsd:dateTime",
  has example "The tenure of the current chairman of the board began in 2021.";
put (resource: $r185, module: $gist_core) isa inModule;

put $r186 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/atDateTime",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/atDateTime",
  has typeLabel "atDateTime",
  has kind "attribute",
  has prefLabel "at date time",
  has definition "The date and time at which something did or will occur, with variants for precision, start and end, and actual vs. planned.",
  has scopeNote "This is the top level property for asserting time, and is not expected to be asserted directly.\n\nThe subproperties allow the ontologist to do three things:\n1) Distinguish start and end times.\n2) Indicate whether a time is planned or actual. This is useful for everything from project management to calendar appointments and the like. It is also useful for date effectivities; i.e., something valid up to a planned date).\n3) Distinguish varying levels of precision; sort of a simple version of the Allen functions.\n\nAll datetimes are of the same format: '2021-06-01T08:03:27.12324-6:00'^^xsd:dateTime. This is compatible with and a subset of ISO 8601.\n\nTime zone offset, such as -6:00 (of which there are a few dozen) is recognized in the date itself, as shown. The actual time zone standard (of which there are 131) may optionally be attached to the event or other object itself.\n\nThere will be many historical dates that do not have a time zone offset (e.g., Lincoln's birthday, as well as about 75% of all legacy systems), and in that case the offset can be omitted.\n\nThe conventions for precision that are repeated in each property name are as follows:\n\t- *DateTime is an abstraction over the various precisions of its subproperties.\n\t- *Date refers to a calendar date (e.g., birthdays and invoice dates) and is assumed to have precision of one day. Time zone offset is allowed.\n\t- *Minute refers to clock time; e.g., a meeting will start at 9:15 with a timezone offset. Precision is assumed to have precision of one minute.\n\t- *Microsecond refers to system time, and it will be as precise as the system can supply; typically at least milliseconds, sometime microseconds.\n";
put (resource: $r186, module: $gist_core) isa inModule;

put $r187 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/birthDate",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/birthDate",
  has typeLabel "birthDate",
  has kind "attribute",
  has prefLabel "birth date",
  has definition "The date some living thing was or will be born, with precision of one day.",
  has scopeNote "This is a subproperty of gist:startDateTime rather than gist:actualStartDate because some living things have yet to be born. This property refers to a calendar date and is assumed to precision of one day (time zone offset is allowed). It is recommended to zero out the hours through microseconds to avoid spurious precision. Implementations requiring a birthdate to the minute can define a subproperty.",
  has example "'2021-06-01T00:00:00-6:00'^^xsd:dateTime";
put (resource: $r187, module: $gist_core) isa inModule;

put $r188 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/containedText",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/containedText",
  has typeLabel "containedText",
  has kind "attribute",
  has prefLabel "contained text",
  has definition "A string that is closely associated with an individual.",
  has example "The string associated with a tag or with text content.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Tag",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Text";
put (resource: $r188, module: $gist_core) isa inModule;

put $r189 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/conversionFactor",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/conversionFactor",
  has typeLabel "conversionFactor",
  has kind "attribute",
  has prefLabel "conversion factor",
  has definition "A value that relates a unit of measure to units of the International System of Units.",
  has scopeNote "To convert a numeric value from one unit of measure to another, multiply by the conversion factor of the first unit and then divide by the conversion factor of the second unit.\n\n\tFor example, to convert 27 feet to yards:\n\n\t\tthe conversion factor of foot is 0.3048\n\t\tthe conversion factor of yard is 0.9144\n\n\t\tso\n\n\t\t27 feet = (27 x 0.3048) / 0.9144 = 9 yards",
  has example "In the equation 1 inch = 0.0254 meters, the value 0.0254 is the conversion factor of inch.",
  has seeAlso "https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset";
put (resource: $r189, module: $gist_core) isa inModule;

put $r190 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset",
  has typeLabel "conversionOffset",
  has kind "attribute",
  has prefLabel "conversion offset",
  has definition "\n\t\tA value used along with a conversion factor to relate a unit to its corresponding unit in the International System of Units. In the equation below, the conversion offset is 459.669607 and the conversion factor is 5/9.\n\n\t\ty degrees Fahrenheit = (y + 459.669607) x 5/9 degrees Kelvin\n\n\t\tTo convert from Fahrenheit to Kelvin, first add the offset and then multiply by the conversion factor.\n\n\t\tTo convert from Kelvin to Fahrenheit, reverse the steps: first divide by the conversion factor and then subtract the offset.";
put (resource: $r190, module: $gist_core) isa inModule;

put $r191 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/deathDate",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/deathDate",
  has typeLabel "deathDate",
  has kind "attribute",
  has prefLabel "death date",
  has definition "The date some living thing died.",
  has scopeNote "Refers to a calendar date and is assumed to have precision of one day (time zone offset is allowed). Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Implementations requiring a death date to the minute can define a subproperty.",
  has example "'2021-06-01T00:00:00-6:00'^^xsd:dateTime";
put (resource: $r191, module: $gist_core) isa inModule;

put $r192 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/description",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/description",
  has typeLabel "description",
  has kind "attribute",
  has prefLabel "description",
  has definition "A statement about someone or something's attributes or characteristics.",
  has scopeNote "This property is used to describe instance data which is not part of the ontology. A definition and a description have different semantics. Use skos:definition for a statement of the meaning of a thing and gist:description to describe a thing's attributes, characteristics, or features.",
  has example "'The Empire State Building is a 102-story Art Deco skyscraper in midtown Manhattan in New York City. It was designed by Shreve, Lamb & Harmon and built from 1930 to 1931.'",
  has example "A person does not have a definition, but might be described as being six feet tall with brown hair and blue eyes; an ontology class or taxonomy term has a definition.";
put (resource: $r192, module: $gist_core) isa inModule;

put $r193 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/encryptedText",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/encryptedText",
  has typeLabel "encryptedText",
  has kind "attribute",
  has prefLabel "encrypted text",
  has definition "Encoded text produced from readable data by an algorithm so that it can only be understood or restored with a decryption key.";
put (resource: $r193, module: $gist_core) isa inModule;

put $r194 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/endDateTime",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/endDateTime",
  has typeLabel "endDateTime",
  has kind "attribute",
  has prefLabel "end date time",
  has definition "The date and time that something ends.",
  has scopeNote "This property is neutral along two dimensions: precision (e.g., day, second, millisecond) and actual vs. planned. As such, it will generally not be asserted directly except in special cases (e.g., for time intervals).",
  has scopeNote "Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.";
put (resource: $r194, module: $gist_core) isa inModule;

put $r195 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfAmpere",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfAmpere",
  has typeLabel "exponentOfAmpere",
  has kind "attribute",
  has prefLabel "exponent of ampere",
  has definition "The exponent of ampere in a product of powers of base units.",
  has example "In the equation '1 milliampere = 0.001 x ampere'\n\n\t\tthe conversionFactor for milliampere is 0.001\n\t\tthe exponent of ampere is 1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing milliampere must be a multiple of ampere.";
put (resource: $r195, module: $gist_core) isa inModule;
