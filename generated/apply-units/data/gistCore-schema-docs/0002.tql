put $r43 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ElectronicAddress",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ElectronicAddress",
  has typeLabel "ElectronicAddress",
  has kind "entity",
  has prefLabel "Electronic Address",
