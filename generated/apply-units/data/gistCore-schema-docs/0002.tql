  has typeLabel "ScheduledEvent",
  has kind "entity",
  has prefLabel "Scheduled Event",
  has definition "An event with a planned start datetime.",
  has scopeNote "If the event already started, but has not yet ended, it is a contemporary event with an actual start datetime. If the event is over, it is a historical event having an actual end datetime. The event always retains its planned start datetime, and thus continues to be a scheduled event.";
put (resource: $r94, module: $gist_core) isa inModule;

