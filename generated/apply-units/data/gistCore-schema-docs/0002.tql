  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ContractTerm",
  has typeLabel "ContractTerm",
  has kind "entity",
  has prefLabel "Contract Term",
  has definition "A specification of some aspect of a contract.";
put (resource: $r36, module: $gist_core) isa inModule;

put $r37 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ControlledVocabulary",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ControlledVocabulary",
  has typeLabel "ControlledVocabulary",
  has kind "entity",
  has prefLabel "Controlled Vocabulary",
  has definition "A collection of terms approved and managed by some organization or person.",
  has scopeNote "A controlled vocabulary is similar to a skos:ConceptScheme, but it could also be used for things that are not concepts, such as organizations, US presidents, geographic regions, etc. Hierarchical relationships between instances of the controlled vocabulary are possible.";
put (resource: $r37, module: $gist_core) isa inModule;

put $r38 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/CountryGeoRegion",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/CountryGeoRegion",
  has typeLabel "CountryGeoRegion",
  has kind "entity",
  has prefLabel "Country Geographic Region",
  has definition "A geographic region governed by exactly one country government.";
put (resource: $r38, module: $gist_core) isa inModule;

put $r39 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/CountryGovernment",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/CountryGovernment",
  has typeLabel "CountryGovernment",
  has kind "entity",
  has prefLabel "Country Government",
  has definition "A government organization which asserts both sovereignty (i.e., it is not governed by some other government organization) and governance over an entity generally recognized as a country.",
  has scopeNote "While a country government may enter into treaties with other country governments, there are no governing relationships among the treaty members.";
put (resource: $r39, module: $gist_core) isa inModule;

