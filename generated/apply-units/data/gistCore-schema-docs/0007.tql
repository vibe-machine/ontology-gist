  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isFirstMemberOf",
  has typeLabel "isFirstMemberOf",
  has kind "relation",
  has prefLabel "is first member of",
  has definition "Relates the first member of an ordered collection to the collection.",
  has scopeNote "Given the Open World Assumption, the absence of a predecessor does not entail that an ordered member is the first member of an ordered collection. This property is used to explicitly indicate the first member. Since ordered collections need not be strictly ordered, there can be more than one first member.";
put (resource: $r151, module: $gist_core) isa inModule;

