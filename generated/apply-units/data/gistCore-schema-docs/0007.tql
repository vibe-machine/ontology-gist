put $gist_core isa SchemaModule,
  has moduleKey "gist-core",
  has moduleName "gistCore",
  has moduleKind "gist-core";

put $r144 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentOf",
  has typeLabel "isAssignmentOf",
  has kind "relation",
  has prefLabel "is assignment of",
  has definition "Relates an assignment to the resource it assigns.",
  has scopeNote "People, organizations, monetary amounts, equipment can all be assigned.",
  has scopeNote "While typically this predicate will be used with assignment subjects, there may be other use cases, and therefore a domain is not specified.",
  has example "Assignment of a person to a project.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Assignment";
put (resource: $r144, module: $gist_core) isa inModule;

put $r145 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentTo",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentTo",
  has typeLabel "isAssignmentTo",
  has kind "relation",
  has prefLabel "is assignment to",
  has definition "Relates something (typically an assignment) to the thing the resource is assigned to, such as a project, position, organization, pay rate, or billing rate.",
  has scopeNote "While typically this predicate will be used with gist:Assignment subjects, there may be other use cases, and therefore a domain is not specified.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Assignment";
put (resource: $r145, module: $gist_core) isa inModule;

