  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude",
  has typeLabel "hasMagnitude",
  has kind "relation",
  has prefLabel "has magnitude",
  has definition "Relates a thing to a magnitude.",
  has example "A car or model of car has magnitudes for length, width, weight, average miles per gallon, etc.";
put (resource: $r129, module: $gist_core) isa inModule;

put $r130 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasMultiplier",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasMultiplier",
  has typeLabel "hasMultiplier",
  has kind "relation",
  has prefLabel "has multiplier",
  has definition "Relates a unit of measure to another unit of measure that is a factor, or relates an aspect to another aspect that is a factor.",
  has scopeNote "Provides a supplemental method of decomposing a unit of measure or aspect into component factors. Enables dimensional analysis such as miles per hour x hours = miles.",
  has example "Miles per hour has miles as a multiplier and hours as a divisor; speed has distance as a multiplier and duration as a divisor.";
put (resource: $r130, module: $gist_core) isa inModule;

put $r131 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasNavigationalParent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasNavigationalParent",
  has typeLabel "hasNavigationalParent",
  has kind "relation",
  has prefLabel "has navigational parent",
  has definition "Relates a child category to a parent category in an informal (e.g., faceted) hierarchy.",
  has example "Refrigerator handles are not refrigerators, but it may be useful to represent their relationship hierarchically for a faceted UI filter.";
put (resource: $r131, module: $gist_core) isa inModule;

put $r132 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant",
  has typeLabel "hasParticipant",
  has kind "relation",
  has prefLabel "has participant",
  has definition "Relates something (e.g. an agreement) to things that play a role, or take part or are otherwise involved in some way.",
  has scopeNote "The thing with participants will often be an agreement, event or obligation. Participation does not imply agency.",
  has scopeNote "This will most often be used as an abstract property. Use subproperties that indicate the nature of the participation (e.g. hasBorrower, hasVenue).",
  has example "An event of transferring money has a participating account that receives the money.";
put (resource: $r132, module: $gist_core) isa inModule;

put $r133 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasParty",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasParty",
  has typeLabel "hasParty",
  has kind "relation",
  has prefLabel "has party",
  has definition "Relates an event, agreement, or obligation to a participating person or organization.",
  has scopeNote "Subproperties may be defined to describe specific parties, such as hasLender and hasBorrower for a loan.",
  has example "Loan agreements have lender and borrower parties.";
put (resource: $r133, module: $gist_core) isa inModule;

put $r134 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasPhysicalLocation",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasPhysicalLocation",
  has typeLabel "hasPhysicalLocation",
  has kind "relation",
  has prefLabel "has physical location",
  has definition "Relates something to its physical location.",
  has scopeNote "This property does not distinguish between things whose locations are stable and those whose locations change over time; e.g., a fire hydrant vs. a car.";
put (resource: $r134, module: $gist_core) isa inModule;

put $r135 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasRecipient",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasRecipient",
  has typeLabel "hasRecipient",
  has kind "relation",
  has prefLabel "has recipient",
  has definition "Relates something to the participant that receives or is intended to receive it.",
  has scopeNote "This property is used in abstract contexts such as agreements, obligations, contracts, etc., whereas gist:goesToAgent is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another. However, there are contexts in which either may be appropriate, such as the giving of a gift.",
  has example "An offer is made to a recipient; an obligation has a recipient to whom another person is obligated; a gift is bestowed upon a recipient.";
put (resource: $r135, module: $gist_core) isa inModule;

