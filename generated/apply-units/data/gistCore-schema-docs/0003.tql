  has typeLabel "hasSubtrahend",
  has kind "relation",
  has prefLabel "has subtrahend",
  has definition "Relates an aspect to another aspect that is a subtracted component of it.",
  has scopeNote "Commonly used with financial metrics.",
  has example "In the equation 'profit = revenue - expenses', revenue is an addend and expenses is a subtrahend.";
put (resource: $r136, module: $gist_core) isa inModule;

