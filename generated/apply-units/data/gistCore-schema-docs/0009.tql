  has typeLabel "exponentOfOther",
  has kind "attribute",
  has prefLabel "exponent of other",
  has definition "Indicates whether a unit of measure can be expressed in terms of the standard exponents (as shown in the examples).",
  has scopeNote "Set the value to 0 if the units of measure in the unit group can be expressed using the standard set of exponents (as in the examples).\n\n\t\tOtherwise set the value to 1, which typically means the units of measure in the group use a logarithmic scale.",
  has example "Decibel, pH, and octave are units of measure that are logarithmic. Their unit groups have exponent of other = 1.";
put (resource: $r203, module: $gist_core) isa inModule;

