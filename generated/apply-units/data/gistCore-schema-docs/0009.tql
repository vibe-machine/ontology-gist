  has typeLabel "exponentOfAmpere",
  has kind "attribute",
  has prefLabel "exponent of ampere",
  has definition "The exponent of ampere in a product of powers of base units.",
  has example "In the equation '1 milliampere = 0.001 x ampere'\n\n\t\tthe conversionFactor for milliampere is 0.001\n\t\tthe exponent of ampere is 1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing milliampere must be a multiple of ampere.";
put (resource: $r195, module: $gist_core) isa inModule;

