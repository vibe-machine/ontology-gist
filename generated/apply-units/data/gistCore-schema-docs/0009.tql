put $gist_core isa SchemaModule,
  has moduleKey "gist-core",
  has moduleName "gistCore",
  has moduleKind "gist-core";

put $r192 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/description",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/description",
  has typeLabel "description",
  has kind "attribute",
  has prefLabel "description",
  has definition "A statement about someone or something's attributes or characteristics.",
  has scopeNote "This property is used to describe instance data which is not part of the ontology. A definition and a description have different semantics. Use skos:definition for a statement of the meaning of a thing and gist:description to describe a thing's attributes, characteristics, or features.",
  has example "'The Empire State Building is a 102-story Art Deco skyscraper in midtown Manhattan in New York City. It was designed by Shreve, Lamb & Harmon and built from 1930 to 1931.'",
  has example "A person does not have a definition, but might be described as being six feet tall with brown hair and blue eyes; an ontology class or taxonomy term has a definition.";
put (resource: $r192, module: $gist_core) isa inModule;

put $r193 isa SchemaResource,
