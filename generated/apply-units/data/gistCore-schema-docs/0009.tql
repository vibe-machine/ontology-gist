  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfKelvin",
  has typeLabel "exponentOfKelvin",
  has kind "attribute",
  has prefLabel "exponent of Kelvin",
  has definition "The exponent of Kelvin in a product of powers of base units.",
  has example "In the equation 'y degrees Fahrenheit = (y + 459.6669607) x 5/9 degrees Kelvin'\n\n\t\tthe conversion offset for degree Fahrenheit is 459.6669607\n\t\tthe conversion factor for degree Fahrenheit is 5/9\n\t\tthe exponent of Kelvin is 1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing degree Fahrenheit will have a similar equation, with different offset or conversion factor (or both).";
