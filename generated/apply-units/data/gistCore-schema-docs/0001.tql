  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Building",
  has typeLabel "Building",
  has kind "entity",
  has prefLabel "Building",
  has definition "A relatively permanent man-made structure situated on a plot of land, having a roof and walls, commonly used for dwelling, entertaining, or working.",
  has scopeNote "User discretion can be applied to edge cases: e.g., is a traditional yurt 'relatively permanently situated' although it is portable and has a tent-like construction?",
  has example "A house, school, store, factory, chicken coop.",
  has example "Negative examples: houseboats (not built on land), caves (not man-made), food trucks and RVs (not permanently situated).";
put (resource: $r22, module: $gist_core) isa inModule;

