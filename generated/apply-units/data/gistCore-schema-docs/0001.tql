put $r47 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Event",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Event",
  has typeLabel "Event",
  has kind "entity",
  has prefLabel "Event",
  has definition "Something that occurs over a period of time, often characterized as an activity being carried out by some person, organization, or software application or brought about by natural forces.",
  has scopeNote "An event does not necessarily have either planned or actual start or end datetimes. For example, a conference can be in the planning phase without any dates selected, but is nevertheless an (unscheduled) event. The subclasses of gist:Event state particular restrictions on planned and actual start and end dates.",
  has scopeNote "An event occurs during a time interval, which is distinct from the event.",
  has example "A transaction, conference, baseball game, earthquake.";
put (resource: $r47, module: $gist_core) isa inModule;

