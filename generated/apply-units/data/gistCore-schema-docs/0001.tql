  has iri "https://w3id.org/semanticarts/ns/ontology/gist/AddressUsageType",
  has typeLabel "AddressUsageType",
  has kind "entity",
  has prefLabel "Address Usage Type",
  has definition "A category indicating the context or manner in which an address may be used.",
  has scopeNote "If you are using temporal relations involving addresses, this category should be used to qualify the temporal relation rather than the address itself, since the same address may have different uses in different contexts, by different people and organizations, or at different times.",
  has example "Billing, business, personal, postal, residence.";
put (resource: $r17, module: $gist_core) isa inModule;

put $r18 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Agreement",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Agreement",
  has typeLabel "Agreement",
  has kind "entity",
  has prefLabel "Agreement",
  has definition "A mutually understood arrangement in which two or more parties make commitments to one another.",
  has scopeNote "While an agreement has two or more parties, and contains commitments which bind those parties, it will not always be necessary to instantiate each individual commitment.",
  has example "A gym membership is an agreement in which the member commits to paying the gym a certain price and the gym commits to allowing access to their facilities.";
put (resource: $r18, module: $gist_core) isa inModule;

put $r19 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Aspect",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Aspect",
  has typeLabel "Aspect",
  has kind "entity",
  has prefLabel "Aspect",
  has definition "A measurable characteristic.",
  has scopeNote "Depending on implementation, every aspect should be related to a unit group either directly or through a broader aspect. For example, angle of incidence could be related to the broader concept of angle, which in turn is related to a unit group, or it could be related directly to the unit group without the hierarchical relationship.",
  has example "Length, weight, cost, cycle time, defect rate.";
put (resource: $r19, module: $gist_core) isa inModule;

put $r20 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Assignment",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Assignment",
  has typeLabel "Assignment",
  has kind "entity",
  has prefLabel "Assignment",
  has definition "A temporal relationship between an assignee, the thing assigned, and the resource that made the assignment.",
  has scopeNote "Based on the Open World Assumption, the assigner may not be asserted or known.",
  has scopeNote "For some assignments, such as the assignment of a person to a task, it may seem equally correct in ordinary speech to say it is an assignment of a task to a person. Since gist:isAssignmentTo and gist:isAssignmentOf have no formal domains or ranges, the choice of which predicate to use for which is left as an implementation decision. Consistency is a key consideration.",
  has example "An employee is assigned to a task by a supervisor. A person is assigned to a position.";
put (resource: $r20, module: $gist_core) isa inModule;

