put $r174 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/refersTo",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/refersTo",
  has typeLabel "refersTo",
  has kind "relation",
  has prefLabel "refers to",
  has definition "Relates something to another resource that it points to, indicates, or references.";
put (resource: $r174, module: $gist_core) isa inModule;

put $r175 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/requires",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/requires",
  has typeLabel "requires",
  has kind "relation",
  has prefLabel "requires",
  has definition "The subject needs the object or makes it necessary, mandatory, or compulsory.",
  has scopeNote "This predicate is defined generally enough to encompass a few different meanings of the English word 'requires':\n\n\t\t1. To need something or to make something necessary.\n\t\t2. To order or demand something, or to order someone to do something, especially because of a rule or law.\n\t\t3. To make it officially necessary for someone to do something.\n\n\tImplementations requiring a more specific meaning should define subproperties.",
  has example "Humans require air; solar power requires sunshine.";
put (resource: $r175, module: $gist_core) isa inModule;

put $r176 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDate",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDate",
  has typeLabel "actualEndDate",
  has kind "attribute",
  has prefLabel "actual end date",
  has definition "The actual date that something ended, with precision of one day.",
  has scopeNote "Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.",
  has example "'2021-06-01T00:00:00-6:00'^^xsd:dateTime";
put (resource: $r176, module: $gist_core) isa inModule;

put $r177 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime",
  has typeLabel "actualEndDateTime",
  has kind "attribute",
  has prefLabel "actual end date time",
  has definition "The actual date and time that something ended, with no implied precision.",
  has scopeNote "This is an abstraction over the various precisions of actual end time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.";
put (resource: $r177, module: $gist_core) isa inModule;

put $r178 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMicrosecond",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMicrosecond",
  has typeLabel "actualEndMicrosecond",
  has kind "attribute",
  has prefLabel "actual end microsecond",
  has definition "The actual time that something ended, expressed as a system time used for timestamps.",
  has scopeNote "A system time will be as precise as the system can supply, typically at least milliseconds, sometimes microseconds. The convention for timestamps, such as recording a transaction, is to specify just the end point; the start time is rarely needed.",
  has example "'2021-06-01T08:03:27.12324-6:00'^^xsd:dateTime";
put (resource: $r178, module: $gist_core) isa inModule;

put $r179 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMinute",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMinute",
  has typeLabel "actualEndMinute",
  has kind "attribute",
  has prefLabel "actual end minute",
  has definition "The actual date and time that something ended, with precision of one minute.",
  has scopeNote "Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.",
  has example "'2021-06-01T08:32:00-6:00'^^xsd:dateTime";
put (resource: $r179, module: $gist_core) isa inModule;

put $r180 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualEndYear",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndYear",
  has typeLabel "actualEndYear",
  has kind "attribute",
  has prefLabel "actual end year",
  has definition "The actual date that something ended, with precision of one year.",
  has scopeNote "Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.",
  has example "'2021-01-01T00:00:00-6:00'^^xsd:dateTime",
  has example "The tenure of the previous chairman of the board ended in 2021.";
put (resource: $r180, module: $gist_core) isa inModule;

