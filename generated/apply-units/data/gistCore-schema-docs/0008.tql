  has typeLabel "actualStartDate",
  has kind "attribute",
  has prefLabel "actual start date",
  has definition "The actual date that something started, with precision of one day.",
  has scopeNote "Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.",
  has example "'2021-06-01T00:00:00-6:00'^^xsd:dateTime";
put (resource: $r181, module: $gist_core) isa inModule;

