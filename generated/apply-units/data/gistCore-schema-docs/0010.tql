put $gist_core isa SchemaModule,
  has moduleKey "gist-core",
  has moduleName "gistCore",
  has moduleKind "gist-core";

put $r216 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndMinute",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndMinute",
  has typeLabel "plannedEndMinute",
  has kind "attribute",
  has prefLabel "planned end minute",
  has definition "The date and time that something is or was planned to end, with precision of one minute.",
  has scopeNote "Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual.",
  has example "'2021-06-01T08:32:00-6:00'^^xsd:dateTime";
put (resource: $r216, module: $gist_core) isa inModule;

put $r217 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndYear",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndYear",
  has typeLabel "plannedEndYear",
  has kind "attribute",
  has prefLabel "planned end year",
  has definition "The date that something is or was planned to end, with precision of one year.",
  has scopeNote "Used for anything with a planned end date where precision of one year is sufficient. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.",
  has example "'2021-01-01T00:00:00-6:00'^^xsd:dateTime",
  has example "The automobile manufacturer announced that it will stop producing gas-powered vehicles in 2035.";
put (resource: $r217, module: $gist_core) isa inModule;

put $r218 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDate",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDate",
  has typeLabel "plannedStartDate",
  has kind "attribute",
  has prefLabel "planned start date",
  has definition "The date that something is or was planned to start, with precision of one day.",
  has scopeNote "Used for anything with a planned start date, such as when a lease will start, when a configuration becomes available, etc. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.",
  has example "'2021-06-01T00:00:00-6:00'^^xsd:dateTime";
put (resource: $r218, module: $gist_core) isa inModule;

put $r219 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime",
  has typeLabel "plannedStartDateTime",
  has kind "attribute",
  has prefLabel "planned start date time",
  has definition "The date and time that something is or was planned to start, with no implied precision.",
  has scopeNote "This is an abstraction over the various precisions of planned start time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.",
  has scopeNote "This property, unlike gist:actualStartDateTime, does not have a subproperty for microsecond precision, because planned times typically are not expressed at that level of granularity. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual.";
put (resource: $r219, module: $gist_core) isa inModule;

