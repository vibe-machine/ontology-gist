  has typeLabel "plannedStartMinute",
  has kind "attribute",
  has prefLabel "planned start minute",
  has definition "The date and time that something is or was planned to start, with precision of one minute.",
  has scopeNote "Used for things like meetings and time card entries, where the hour and minute are important. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.",
  has example "'2021-06-01T08:32:00-6:00'^^xsd:dateTime";
put (resource: $r220, module: $gist_core) isa inModule;

put $r221 isa SchemaResource,
