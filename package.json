{
  "name": "gist",
  "displayName": "gist Upper Ontology",
  "version": "2.0.1",
  "description": "Semantic Arts foundational types for enterprise knowledge graphs. Provides core abstractions like Event, Task, Category, Organization, and Person.",
  "scripts": {
    "parse:ir": "node tools/gist_to_typeql/parse_gist.mjs --out manifests/gist-v2.0.1.ir-summary.json",
    "emit:structural": "node tools/gist_to_typeql/emit_structural.mjs",
    "emit:schema-docs": "node tools/gist_to_typeql/emit_schema_docs.mjs",
    "update:headers": "node tools/gist_to_typeql/update_headers.mjs",
    "refresh:package-contract": "npm run update:headers && npm run parse:ir && npm run emit:schema-docs && npm run emit:structural",
    "validate:bootstrap": "node tools/gist_to_typeql/validate_bootstrap.mjs",
    "test:typedb-bootstrap": "node tools/package_contract/validate_typedb_bootstrap.mjs",
    "test": "npm run validate:bootstrap && npm run test:typedb-bootstrap",
    "release": "../ontology-tooling/bin/ontology-release --repo .",
    "release:check": "../ontology-tooling/bin/ontology-release --repo . --validate-only"
  },
  "author": "Semantic Arts, Inc.",
  "license": "CC-BY-SA-4.0",
  "source": "https://github.com/semanticarts/gist",
  "prefix": "gist",
  "schemas": [
    {
      "name": "self-describing-schema",
      "file": "schema/self-describing-schema.tql"
    },
    {
      "name": "package-provenance",
      "file": "schema/package-provenance.tql"
    },
    {
      "name": "administrative-operations",
      "file": "schema/administrative-operations.tql"
    },
    {
      "name": "gistCore",
      "file": "schema/gistCore.tql"
    }
  ],
  "data": [
    "data/gistCore-domain-seeds.tql",
    "data/gistCore-provenance.tql",
    "data/gistCore-schema-docs.tql"
  ],
  "queries": [
    "queries/gistCore-axioms.tql"
  ],
  "manifests": [
    "manifests/gist-v2.0.1.translation-manifest.json",
    "manifests/gist-v2.0.1.axiom-queries.json"
  ],
  "assembly": {
    "loadOrder": [
      "schema/self-describing-schema.tql",
      "schema/gistCore.tql",
      "schema/package-provenance.tql",
      "schema/administrative-operations.tql",
      "data/gistCore-domain-seeds.tql",
      "data/gistCore-provenance.tql",
      "data/gistCore-schema-docs.tql"
    ],
    "generatedArtifacts": [
      "schema/self-describing-schema.tql",
      "schema/package-provenance.tql",
      "schema/administrative-operations.tql",
      "schema/gistCore.tql",
      "data/gistCore-domain-seeds.tql",
      "data/gistCore-provenance.tql",
      "data/gistCore-schema-docs.tql",
      "queries/gistCore-axioms.tql",
      "manifests/gist-v2.0.1.axiom-queries.json",
      "manifests/gist-v2.0.1.translation-manifest.json",
      "manifests/gist-v2.0.1.translation-report.json",
      "manifests/gist-v2.0.1.ir-summary.json"
    ]
  },
  "upstream": {
    "repo": "https://github.com/semanticarts/gist",
    "tag": "v14.0.0",
    "commit": "6ab80c158a7fa56a1b5d3d824b125b92107e8f08",
    "sourceArtifacts": [
      "upstream/gist/v14.0.0/ontologies/gistCore.ttl",
      "upstream/gist/v14.0.0/ontologies/gistMediaTypes.ttl",
      "upstream/gist/v14.0.0/ontologies/gistPrefixDeclarations.ttl",
      "upstream/gist/v14.0.0/ontologies/gistValidationAnnotations.ttl"
    ]
  },
  "provenance": {
    "manifest": "manifests/gist-v2.0.1.translation-manifest.json",
    "status": "bootstrap"
  },
  "devDependencies": {
    "n3": "^2.0.3"
  }
}
