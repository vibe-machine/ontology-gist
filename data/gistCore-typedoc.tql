# gist Core TypeDoc - Semantic Documentation
# Insert after loading typedoc.tql schema
#
# Provides queryable documentation for gist ontology types.
# Source: gist v14.0.0 (https://w3id.org/semanticarts/ontology/gistCore)
# Reference: kg/docs/THE_GRAPH_THAT_KNOWS_ITSELF.md

insert

# =============================================================================
# Core Abstract Entities
# =============================================================================

$event_doc isa TypeDoc,
    has typeLabel "Event",
    has typeKind "entity",
    has definition "A temporal occurrence - something that happens at a point or during an interval of time. Events have actual and planned start/end times and can have participants and locations.",
    has usageNote "Event is the base type for all temporal occurrences. Use subtypes like Task, Transaction, or ScheduledEvent for specific event kinds. Beads extend Task which extends Event.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Event";

$task_doc isa TypeDoc,
    has typeLabel "Task",
    has typeKind "entity",
    has definition "A planned activity with a goal. Tasks are Events that represent work to be done, with the ability to track progress toward completion.",
    has usageNote "Task extends Event and adds goal tracking via hasGoal relation. Bead extends Task to add issue tracking capabilities. Use Task for generic work items; use Bead for tracked issues.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Task";

$category_doc isa TypeDoc,
    has typeLabel "Category",
    has typeKind "entity",
    has definition "A classification or type used to categorize other entities. Categories provide taxonomic organization and can be hierarchical.",
    has usageNote "Use isCategorizedBy relation to assign categories. BeadType, BeadStatus, and BeadPriority are Category subtypes. Agent also extends Category.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Category";

$organization_doc isa TypeDoc,
    has typeLabel "Organization",
    has typeKind "entity",
    has definition "A group of people organized for a common purpose. Organizations can own things, produce products, govern other entities, and have members.",
    has usageNote "Use for companies, teams, departments. Rig extends Organization to represent git repositories as workspaces.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Organization";

$person_doc isa TypeDoc,
    has typeLabel "Person",
    has typeKind "entity",
    has definition "An individual human being. Persons can own things, produce products, participate in events, and have biological relationships.",
    has usageNote "Use for human users and team members. CrewWorker extends Person for human developers in a rig.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Person";

$aspect_doc isa TypeDoc,
    has typeLabel "Aspect",
    has typeKind "entity",
    has definition "A measurable characteristic or property. Aspects define what can be measured about something (e.g., length, weight, duration).",
    has usageNote "Aspects are connected to Magnitudes which hold the actual numeric values. Use hasAspect to connect an entity to its measurable properties.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Aspect";

$magnitude_doc isa TypeDoc,
    has typeLabel "Magnitude",
    has typeKind "entity",
    has definition "A numeric value with an associated unit of measure and aspect. Magnitudes represent the actual measured values of properties.",
    has usageNote "Magnitude connects to Aspect (what is measured), UnitOfMeasure (the unit), and holds numericValue (the number). Use hasMagnitude to attach to entities.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Magnitude";

$content_doc isa TypeDoc,
    has typeLabel "Content",
    has typeKind "entity",
    has definition "Information or data that can be about something. Content is the base type for all informational entities like text, messages, and addresses.",
    has usageNote "Use subtypes like Text, Message, Address, or ID for specific content kinds. Content can be expressed in a Language and rendered on a Medium.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Content";

$geo_location_doc isa TypeDoc,
    has typeLabel "GeoLocation",
    has typeKind "entity",
    has definition "A place in geographic space. Can be a point (latitude/longitude), region, or volume. Events can occur in GeoLocations.",
    has usageNote "Use GeoPoint for specific coordinates, GeoRegion for areas. Connect to entities via hasPhysicalLocation or occursIn relations.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#GeoLocation";

$collection_doc isa TypeDoc,
    has typeLabel "Collection",
    has typeKind "entity",
    has definition "A group of items gathered together. Collections can have members and can be ordered (OrderedCollection) or unordered.",
    has usageNote "Use isMemberOfCollection to add items. UnitGroup is a Collection of UnitOfMeasure. Network is a Collection of NetworkNodes.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Collection";

$intention_doc isa TypeDoc,
    has typeLabel "Intention",
    has typeKind "entity",
    has definition "A purpose or design - something meant to happen or be achieved. Intentions include commitments, specifications, and permissions.",
    has usageNote "Agreement, Specification, and Commitment extend Intention. Use for contracts, requirements, and planned behaviors.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Intention";

$temporal_relation_doc isa TypeDoc,
    has typeLabel "TemporalRelation",
    has typeKind "entity",
    has definition "A relationship that has temporal extent - it exists during a time interval with start and end times.",
    has usageNote "StatusPeriod extends TemporalRelation to track bead status over time. Use for any relationship that needs temporal tracking.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#TemporalRelation";

# =============================================================================
# Key Relations
# =============================================================================

$is_part_of_doc isa TypeDoc,
    has typeLabel "isPartOf",
    has typeKind "relation",
    has definition "Expresses that something is a component or constituent of something else. The part-whole relationship is transitive.",
    has usageNote "Roles: whole (the containing entity), part (the contained entity). Use for hierarchical containment. Bead uses this for parent-child relationships.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#isPartOf";

$is_categorized_by_doc isa TypeDoc,
    has typeLabel "isCategorizedBy",
    has typeKind "relation",
    has definition "Assigns a category to an entity for classification purposes. Multiple categories can be assigned to the same entity.",
    has usageNote "Roles: categorized (the entity being classified), category (the Category being assigned). Use for type/status/priority assignment.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#isCategorizedBy";

$precedes_doc isa TypeDoc,
    has typeLabel "precedes",
    has typeKind "relation",
    has definition "Expresses temporal or logical ordering where one thing comes before another. The precedes relationship is transitive.",
    has usageNote "Roles: predecessor (comes before), successor (comes after). Bead uses this for blocking dependencies.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#precedes";

$refers_to_doc isa TypeDoc,
    has typeLabel "refersTo",
    has typeKind "relation",
    has definition "Indicates that something references or points to something else without implying containment or ordering.",
    has usageNote "Roles: referrer (the thing doing the referencing), referent (the thing being referenced). Use for cross-references and links.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#refersTo";

$has_participant_doc isa TypeDoc,
    has typeLabel "hasParticipant",
    has typeKind "relation",
    has definition "Associates an event with an entity that participates in it. Participants can be people, organizations, or other entities.",
    has usageNote "Roles: participatedEvent (the Event), participant (the participating entity). Use for attendees, actors, stakeholders.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#hasParticipant";

$occurs_in_doc isa TypeDoc,
    has typeLabel "occursIn",
    has typeKind "relation",
    has definition "Associates an event with the location where it takes place.",
    has usageNote "Roles: occurringEvent (the Event), eventLocation (the GeoLocation). Use to place events geographically.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#occursIn";

$has_goal_doc isa TypeDoc,
    has typeLabel "hasGoal",
    has typeKind "relation",
    has definition "Associates a task with its intended outcome or objective.",
    has usageNote "Roles: goalTask (the Task), goal (the intended outcome). Task extends Event and plays the goalTask role.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#hasGoal";

# =============================================================================
# Event Subtypes
# =============================================================================

$scheduled_event_doc isa TypeDoc,
    has typeLabel "ScheduledEvent",
    has typeKind "entity",
    has definition "An event that is planned to occur at a specific time. Has both planned and actual timing attributes.",
    has usageNote "Use for meetings, deadlines, milestones. Compare planned vs actual times to track schedule adherence.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#ScheduledEvent";

$transaction_doc isa TypeDoc,
    has typeLabel "Transaction",
    has typeKind "entity",
    has definition "An event involving transfer or exchange - of goods, services, money, or information between parties.",
    has usageNote "Use for purchases, payments, data transfers. Connect parties via hasGiver/hasRecipient relations.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Transaction";

$project_doc isa TypeDoc,
    has typeLabel "Project",
    has typeKind "entity",
    has definition "A planned endeavor with defined scope, typically temporary, undertaken to create a unique product, service, or result.",
    has usageNote "Project extends Event. Use for large initiatives that contain multiple tasks or beads.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Project";

# =============================================================================
# Content Subtypes
# =============================================================================

$text_doc isa TypeDoc,
    has typeLabel "Text",
    has typeKind "entity",
    has definition "Content consisting of written characters. Stores the actual text in containedText attribute.",
    has usageNote "Text extends ContentExpression. Use for descriptions, comments, documentation. Can be expressed in a Language.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Text";

$id_doc isa TypeDoc,
    has typeLabel "ID",
    has typeKind "entity",
    has definition "A unique identifier that distinguishes one entity from another. Stores the identifier value in uniqueText.",
    has usageNote "ID extends Content. Use isIdentifiedBy relation to attach IDs to entities. IDs can be allocated by IntellectualProperty.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#ID";

$address_doc isa TypeDoc,
    has typeLabel "Address",
    has typeKind "entity",
    has definition "A locator that can be used to find or contact something. Can be physical (street address) or electronic (email, URL).",
    has usageNote "Use hasAddress relation to attach. PhysicalAddress and ElectronicAddress are subtypes for specific address kinds.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#Address";

# =============================================================================
# Organization Subtypes
# =============================================================================

$government_organization_doc isa TypeDoc,
    has typeLabel "GovernmentOrganization",
    has typeKind "entity",
    has definition "An organization that exercises governmental authority - making and enforcing laws, providing public services.",
    has usageNote "CountryGovernment and SubCountryGovernment are subtypes. Use isUnderJurisdictionOf to show governance relationships.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#GovernmentOrganization";

# =============================================================================
# Measurement Types
# =============================================================================

$unit_of_measure_doc isa TypeDoc,
    has typeLabel "UnitOfMeasure",
    has typeKind "entity",
    has definition "A standard quantity used as a basis for measurement. Has a symbol and conversion factors to relate to other units.",
    has usageNote "Connect to Magnitude via hasUnitOfMeasure. Units belong to UnitGroups (e.g., length units, time units).",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#UnitOfMeasure";

$unit_group_doc isa TypeDoc,
    has typeLabel "UnitGroup",
    has typeKind "entity",
    has definition "A collection of related units of measure that measure the same kind of thing (e.g., length: meters, feet, inches).",
    has usageNote "UnitGroup extends Collection. Connect Aspects to UnitGroups via hasUnitGroup to define what units can measure them.",
    has sourceIRI "https://w3id.org/semanticarts/ontology/gistCore#UnitGroup";
