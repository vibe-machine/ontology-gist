  has typeLabel "UnitOfMeasure",
  has kind "entity",
  has prefLabel "Unit Of Measure",
  has definition "A standard quantity used as a basis for measurement. Has a symbol and conversion factors to relate to other units.",
  has scopeNote "Connect to Magnitude via hasUnitOfMeasure. Units belong to UnitGroups (e.g., length units, time units).";
put (resource: $r27, module: $gist_core) isa inModule;

put $r28 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#UnitGroup",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#UnitGroup",
  has typeLabel "UnitGroup",
  has kind "entity",
  has prefLabel "Unit Group",
  has definition "A collection of related units of measure that measure the same kind of thing (e.g., length: meters, feet, inches).",
