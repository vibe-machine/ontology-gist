put $gist_core isa SchemaModule,
  has moduleKey "gist-core",
  has moduleName "gistCore",
  has moduleKind "gist-core";

put $r1 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Event",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Event",
  has typeLabel "Event",
  has kind "entity",
  has prefLabel "Event",
  has definition "A temporal occurrence - something that happens at a point or during an interval of time. Events have actual and planned start/end times and can have participants and locations.",
  has scopeNote "Event is the base type for all temporal occurrences. Use subtypes like Task, Transaction, or ScheduledEvent for specific event kinds. Beads extend Task which extends Event.";
put (resource: $r1, module: $gist_core) isa inModule;

put $r2 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Task",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Task",
  has typeLabel "Task",
  has kind "entity",
  has prefLabel "Task",
  has definition "A planned activity with a goal. Tasks are Events that represent work to be done, with the ability to track progress toward completion.",
  has scopeNote "Task extends Event and adds goal tracking via hasGoal relation. Bead extends Task to add issue tracking capabilities. Use Task for generic work items; use Bead for tracked issues.";
put (resource: $r2, module: $gist_core) isa inModule;

put $r3 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Category",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Category",
  has typeLabel "Category",
  has kind "entity",
  has prefLabel "Category",
  has definition "A classification or type used to categorize other entities. Categories provide taxonomic organization and can be hierarchical.",
  has scopeNote "Use isCategorizedBy relation to assign categories. BeadType, BeadStatus, and BeadPriority are Category subtypes. Agent also extends Category.";
put (resource: $r3, module: $gist_core) isa inModule;

put $r4 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Organization",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Organization",
  has typeLabel "Organization",
  has kind "entity",
  has prefLabel "Organization",
  has definition "A group of people organized for a common purpose. Organizations can own things, produce products, govern other entities, and have members.",
  has scopeNote "Use for companies, teams, departments. Rig extends Organization to represent git repositories as workspaces.";
put (resource: $r4, module: $gist_core) isa inModule;

put $r5 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Person",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Person",
  has typeLabel "Person",
  has kind "entity",
  has prefLabel "Person",
  has definition "An individual human being. Persons can own things, produce products, participate in events, and have biological relationships.",
  has scopeNote "Use for human users and team members. CrewWorker extends Person for human developers in a rig.";
put (resource: $r5, module: $gist_core) isa inModule;

put $r6 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Aspect",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Aspect",
  has typeLabel "Aspect",
  has kind "entity",
  has prefLabel "Aspect",
  has definition "A measurable characteristic or property. Aspects define what can be measured about something (e.g., length, weight, duration).",
  has scopeNote "Aspects are connected to Magnitudes which hold the actual numeric values. Use hasAspect to connect an entity to its measurable properties.";
put (resource: $r6, module: $gist_core) isa inModule;

put $r7 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Magnitude",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Magnitude",
  has typeLabel "Magnitude",
  has kind "entity",
  has prefLabel "Magnitude",
  has definition "A numeric value with an associated unit of measure and aspect. Magnitudes represent the actual measured values of properties.",
  has scopeNote "Magnitude connects to Aspect (what is measured), UnitOfMeasure (the unit), and holds numericValue (the number). Use hasMagnitude to attach to entities.";
put (resource: $r7, module: $gist_core) isa inModule;

put $r8 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Content",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Content",
  has typeLabel "Content",
  has kind "entity",
  has prefLabel "Content",
  has definition "Information or data that can be about something. Content is the base type for all informational entities like text, messages, and addresses.",
  has scopeNote "Use subtypes like Text, Message, Address, or ID for specific content kinds. Content can be expressed in a Language and rendered on a Medium.";
put (resource: $r8, module: $gist_core) isa inModule;

put $r9 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#GeoLocation",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#GeoLocation",
  has typeLabel "GeoLocation",
  has kind "entity",
  has prefLabel "Geo Location",
  has definition "A place in geographic space. Can be a point (latitude/longitude), region, or volume. Events can occur in GeoLocations.",
  has scopeNote "Use GeoPoint for specific coordinates, GeoRegion for areas. Connect to entities via hasPhysicalLocation or occursIn relations.";
put (resource: $r9, module: $gist_core) isa inModule;

put $r10 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Collection",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Collection",
  has typeLabel "Collection",
  has kind "entity",
  has prefLabel "Collection",
  has definition "A group of items gathered together. Collections can have members and can be ordered (OrderedCollection) or unordered.",
  has scopeNote "Use isMemberOfCollection to add items. UnitGroup is a Collection of UnitOfMeasure. Network is a Collection of NetworkNodes.";
put (resource: $r10, module: $gist_core) isa inModule;

put $r11 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Intention",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Intention",
