  has kind "entity",
  has prefLabel "Intention",
  has definition "A purpose or design - something meant to happen or be achieved. Intentions include commitments, specifications, and permissions.",
  has scopeNote "Agreement, Specification, and Commitment extend Intention. Use for contracts, requirements, and planned behaviors.";
put (resource: $r11, module: $gist_core) isa inModule;

put $r12 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#TemporalRelation",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#TemporalRelation",
  has typeLabel "TemporalRelation",
  has kind "entity",
  has prefLabel "Temporal Relation",
  has definition "A relationship that has temporal extent - it exists during a time interval with start and end times.",
  has scopeNote "StatusPeriod extends TemporalRelation to track bead status over time. Use for any relationship that needs temporal tracking.";
put (resource: $r12, module: $gist_core) isa inModule;

put $r13 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#isPartOf",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#isPartOf",
  has typeLabel "isPartOf",
  has kind "relation",
  has prefLabel "is Part Of",
  has definition "Expresses that something is a component or constituent of something else. The part-whole relationship is transitive.",
  has scopeNote "Roles: whole (the containing entity), part (the contained entity). Use for hierarchical containment. Bead uses this for parent-child relationships.";
put (resource: $r13, module: $gist_core) isa inModule;

put $r14 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#isCategorizedBy",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#isCategorizedBy",
  has typeLabel "isCategorizedBy",
  has kind "relation",
  has prefLabel "is Categorized By",
  has definition "Assigns a category to an entity for classification purposes. Multiple categories can be assigned to the same entity.",
  has scopeNote "Roles: categorized (the entity being classified), category (the Category being assigned). Use for type/status/priority assignment.";
put (resource: $r14, module: $gist_core) isa inModule;

put $r15 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#precedes",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#precedes",
  has typeLabel "precedes",
  has kind "relation",
  has prefLabel "precedes",
  has definition "Expresses temporal or logical ordering where one thing comes before another. The precedes relationship is transitive.",
  has scopeNote "Roles: predecessor (comes before), successor (comes after). Bead uses this for blocking dependencies.";
put (resource: $r15, module: $gist_core) isa inModule;

put $r16 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#refersTo",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#refersTo",
  has typeLabel "refersTo",
  has kind "relation",
  has prefLabel "refers To",
  has definition "Indicates that something references or points to something else without implying containment or ordering.",
  has scopeNote "Roles: referrer (the thing doing the referencing), referent (the thing being referenced). Use for cross-references and links.";
put (resource: $r16, module: $gist_core) isa inModule;

put $r17 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#hasParticipant",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#hasParticipant",
  has typeLabel "hasParticipant",
  has kind "relation",
  has prefLabel "has Participant",
  has definition "Associates an event with an entity that participates in it. Participants can be people, organizations, or other entities.",
  has scopeNote "Roles: participatedEvent (the Event), participant (the participating entity). Use for attendees, actors, stakeholders.";
put (resource: $r17, module: $gist_core) isa inModule;

put $r18 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#occursIn",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#occursIn",
  has typeLabel "occursIn",
  has kind "relation",
  has prefLabel "occurs In",
  has definition "Associates an event with the location where it takes place.",
  has scopeNote "Roles: occurringEvent (the Event), eventLocation (the GeoLocation). Use to place events geographically.";
put (resource: $r18, module: $gist_core) isa inModule;

put $r19 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#hasGoal",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#hasGoal",
  has typeLabel "hasGoal",
  has kind "relation",
  has prefLabel "has Goal",
  has definition "Associates a task with its intended outcome or objective.",
  has scopeNote "Roles: goalTask (the Task), goal (the intended outcome). Task extends Event and plays the goalTask role.";
put (resource: $r19, module: $gist_core) isa inModule;

put $r20 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#ScheduledEvent",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#ScheduledEvent",
  has typeLabel "ScheduledEvent",
  has kind "entity",
  has prefLabel "Scheduled Event",
  has definition "An event that is planned to occur at a specific time. Has both planned and actual timing attributes.",
  has scopeNote "Use for meetings, deadlines, milestones. Compare planned vs actual times to track schedule adherence.";
put (resource: $r20, module: $gist_core) isa inModule;

put $r21 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Transaction",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Transaction",
  has typeLabel "Transaction",
  has kind "entity",
  has prefLabel "Transaction",
  has definition "An event involving transfer or exchange - of goods, services, money, or information between parties.",
  has scopeNote "Use for purchases, payments, data transfers. Connect parties via hasGiver/hasRecipient relations.";
put (resource: $r21, module: $gist_core) isa inModule;

put $r22 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Project",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Project",
  has typeLabel "Project",
  has kind "entity",
  has prefLabel "Project",
  has definition "A planned endeavor with defined scope, typically temporary, undertaken to create a unique product, service, or result.",
  has scopeNote "Project extends Event. Use for large initiatives that contain multiple tasks or beads.";
put (resource: $r22, module: $gist_core) isa inModule;

put $r23 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Text",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Text",
  has typeLabel "Text",
  has kind "entity",
  has prefLabel "Text",
  has definition "Content consisting of written characters. Stores the actual text in containedText attribute.",
  has scopeNote "Text extends ContentExpression. Use for descriptions, comments, documentation. Can be expressed in a Language.";
put (resource: $r23, module: $gist_core) isa inModule;

put $r24 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#ID",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#ID",
  has typeLabel "ID",
  has kind "entity",
  has prefLabel "ID",
  has definition "A unique identifier that distinguishes one entity from another. Stores the identifier value in uniqueText.",
  has scopeNote "ID extends Content. Use isIdentifiedBy relation to attach IDs to entities. IDs can be allocated by IntellectualProperty.";
put (resource: $r24, module: $gist_core) isa inModule;

put $r25 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ontology/gistCore#Address",
  has iri "https://w3id.org/semanticarts/ontology/gistCore#Address",
  has typeLabel "Address",
  has kind "entity",
  has prefLabel "Address",
  has definition "A locator that can be used to find or contact something. Can be physical (street address) or electronic (email, URL).",
  has scopeNote "Use hasAddress relation to attach. PhysicalAddress and ElectronicAddress are subtypes for specific address kinds.";
put (resource: $r25, module: $gist_core) isa inModule;

