# Migration: ontology-gist v2.0.0 -> v2.0.3
# Remove legacy gist schema documentation so current bootstrap can reseed it.
# manifest: manifests/gist-v2.0.3.translation-manifest.json

match
  $module isa SchemaModule, has moduleKey "gist-core";
  $link isa inModule (resource: $resource, module: $module);
delete
  $link;
  $resource;

match
  $module isa SchemaModule, has moduleKey "gist-core";
delete
  $module;
