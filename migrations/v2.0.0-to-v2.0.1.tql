  has iri "https://vibe-machine.github.io/schema/self-describing#valueTypeName",
  has typeLabel "valueTypeName",
  has kind "attribute",
  has prefLabel "value type name",
  has definition "For attribute SchemaResources, the TypeQL primitive value type carried by the attribute.";
put (resource: $r6, module: $gist_core) isa inModule;

put $r7 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#inModule",
  has iri "https://vibe-machine.github.io/schema/self-describing#inModule",
  has typeLabel "inModule",
  has kind "relation",
  has prefLabel "in module",
  has definition "Associates a documented schema resource with the ontology module that publishes it.";
put (resource: $r7, module: $gist_core) isa inModule;

put $r8 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#groupInView",
  has iri "https://vibe-machine.github.io/schema/self-describing#groupInView",
  has typeLabel "groupInView",
  has kind "relation",
  has prefLabel "group in view",
  has definition "Associates a schema group with the schema view in which it appears.";
put (resource: $r8, module: $gist_core) isa inModule;

put $r9 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#resourceInGroup",
  has iri "https://vibe-machine.github.io/schema/self-describing#resourceInGroup",
  has typeLabel "resourceInGroup",
  has kind "relation",
  has prefLabel "resource in group",
  has definition "Associates a documented schema resource with a schema group for a particular browsing view.";
put (resource: $r9, module: $gist_core) isa inModule;

put $r10 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#schemaSubTypeOf",
  has iri "https://vibe-machine.github.io/schema/self-describing#schemaSubTypeOf",
  has typeLabel "schemaSubTypeOf",
  has kind "relation",
  has prefLabel "schema subtype of",
  has definition "Associates a schema resource with its direct supertype in queryable metadata.";
put (resource: $r10, module: $gist_core) isa inModule;

put $r11 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#schemaOwns",
  has iri "https://vibe-machine.github.io/schema/self-describing#schemaOwns",
  has typeLabel "schemaOwns",
  has kind "relation",
  has prefLabel "schema owns",
  has definition "Associates a schema resource with an attribute it explicitly owns.";
put (resource: $r11, module: $gist_core) isa inModule;

put $r12 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#schemaPlays",
  has iri "https://vibe-machine.github.io/schema/self-describing#schemaPlays",
  has typeLabel "schemaPlays",
  has kind "relation",
  has prefLabel "schema plays",
  has definition "Associates a schema resource with a relation role it explicitly plays.";
put (resource: $r12, module: $gist_core) isa inModule;

put $r13 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#schemaRelates",
  has iri "https://vibe-machine.github.io/schema/self-describing#schemaRelates",
  has typeLabel "schemaRelates",
  has kind "relation",
  has prefLabel "schema relates",
  has definition "Associates a relation schema resource with one of its explicit role definitions.";
put (resource: $r13, module: $gist_core) isa inModule;

put $r14 isa SchemaResource,
  has docKey "http://www.w3.org/2002/07/owl#Thing",
  has iri "http://www.w3.org/2002/07/owl#Thing",
  has typeLabel "Thing",
  has kind "entity",
  has prefLabel "Thing",
  has definition "The universal root type. All gist entities are direct or indirect subtypes of Thing.";
put (resource: $r14, module: $gist_core) isa inModule;

put $r15 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Account",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Account",
  has typeLabel "Account",
  has kind "entity",
  has prefLabel "Account",
  has definition "An agreement having a balance.",
  has example "A bank account, a credit card account, an accounts receivable account.";
put (resource: $r15, module: $gist_core) isa inModule;

put $r16 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Address",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Address",
  has typeLabel "Address",
  has kind "entity",
  has prefLabel "Address",
  has definition "A reference to a place (real or virtual) that can be located by some routing algorithm and where messages or things can be sent or received.",
  has example "A PO Box, a URL to a PDF file.";
put (resource: $r16, module: $gist_core) isa inModule;

put $r17 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/AddressUsageType",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/AddressUsageType",
  has typeLabel "AddressUsageType",
  has kind "entity",
  has prefLabel "Address Usage Type",
  has definition "A category indicating the context or manner in which an address may be used.",
  has scopeNote "If you are using temporal relations involving addresses, this category should be used to qualify the temporal relation rather than the address itself, since the same address may have different uses in different contexts, by different people and organizations, or at different times.",
  has example "Billing, business, personal, postal, residence.";
put (resource: $r17, module: $gist_core) isa inModule;

put $r18 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Agreement",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Agreement",
  has typeLabel "Agreement",
  has kind "entity",
  has prefLabel "Agreement",
  has definition "A mutually understood arrangement in which two or more parties make commitments to one another.",
  has scopeNote "While an agreement has two or more parties, and contains commitments which bind those parties, it will not always be necessary to instantiate each individual commitment.",
  has example "A gym membership is an agreement in which the member commits to paying the gym a certain price and the gym commits to allowing access to their facilities.";
put (resource: $r18, module: $gist_core) isa inModule;

put $r19 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Aspect",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Aspect",
  has typeLabel "Aspect",
  has kind "entity",
  has prefLabel "Aspect",
  has definition "A measurable characteristic.",
  has scopeNote "Depending on implementation, every aspect should be related to a unit group either directly or through a broader aspect. For example, angle of incidence could be related to the broader concept of angle, which in turn is related to a unit group, or it could be related directly to the unit group without the hierarchical relationship.",
  has example "Length, weight, cost, cycle time, defect rate.";
put (resource: $r19, module: $gist_core) isa inModule;

put $r20 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Assignment",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Assignment",
  has typeLabel "Assignment",
  has kind "entity",
  has prefLabel "Assignment",
  has definition "A temporal relationship between an assignee, the thing assigned, and the resource that made the assignment.",
  has scopeNote "Based on the Open World Assumption, the assigner may not be asserted or known.",
  has scopeNote "For some assignments, such as the assignment of a person to a task, it may seem equally correct in ordinary speech to say it is an assignment of a task to a person. Since gist:isAssignmentTo and gist:isAssignmentOf have no formal domains or ranges, the choice of which predicate to use for which is left as an implementation decision. Consistency is a key consideration.",
  has example "An employee is assigned to a task by a supervisor. A person is assigned to a position.";
put (resource: $r20, module: $gist_core) isa inModule;

put $r21 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Behavior",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Behavior",
  has typeLabel "Behavior",
  has kind "entity",
  has prefLabel "Behavior",
  has definition "A category indicating the nature of an activity.",
  has example "Drilling and cutting are two different kinds of manufacturing event.";
put (resource: $r21, module: $gist_core) isa inModule;

put $r22 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Building",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Building",
  has typeLabel "Building",
  has kind "entity",
  has prefLabel "Building",
  has definition "A relatively permanent man-made structure situated on a plot of land, having a roof and walls, commonly used for dwelling, entertaining, or working.",
  has scopeNote "User discretion can be applied to edge cases: e.g., is a traditional yurt 'relatively permanently situated' although it is portable and has a tent-like construction?",
  has example "A house, school, store, factory, chicken coop.",
  has example "Negative examples: houseboats (not built on land), caves (not man-made), food trucks and RVs (not permanently situated).";
put (resource: $r22, module: $gist_core) isa inModule;

put $r23 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/BundledCatalogItem",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/BundledCatalogItem",
  has typeLabel "BundledCatalogItem",
  has kind "entity",
  has prefLabel "Bundled Catalog Item",
  has definition "Any combination of descriptions of things offered together.",
  has example "A kit containing several parts offered together; a product plus a warranty.";
put (resource: $r23, module: $gist_core) isa inModule;

put $r24 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/CatalogItem",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/CatalogItem",
  has typeLabel "CatalogItem",
  has kind "entity",
  has prefLabel "Catalog Item",
  has definition "A description of a product or service to be delivered, given in a sufficient level of detail that a receiver could determine whether delivery constituted discharge of the obligation to deliver.",
  has scopeNote "In short, an unambiguous characterization of what it is that a potential buyer is paying for.";
put (resource: $r24, module: $gist_core) isa inModule;

put $r25 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Category",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Category",
  has typeLabel "Category",
  has kind "entity",
  has prefLabel "Category",
  has definition "A concept or label used to categorize other instances without specifying any formal semantics.",
  has scopeNote "Often a type can be modeled either as an owl:Class or as a gist:Category. Use the latter if you don't care much about the formal structure of the different types, or if there is a whole hierarchy of types that are going to be managed by a group separate from the ontology developers. The formal structure may be defined elsewhere and linked to, if necessary.",
  has example "Tags used in folksonomies; formal definitions from other systems.";
put (resource: $r25, module: $gist_core) isa inModule;

put $r26 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Collection",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Collection",
  has typeLabel "Collection",
  has kind "entity",
  has prefLabel "Collection",
  has definition "A grouping of things.",
  has scopeNote "Individuals are placed in the collection using the gist:isMemberOf property. Collections typically are created because the members are functionally connected in some way. This definition allows a collection to have zero members.",
  has example "A jury is a group of people; a financial ledger is a collection of transaction entries; a route is an (ordered) collection of segments.";
put (resource: $r26, module: $gist_core) isa inModule;

put $r27 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Commitment",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Commitment",
  has typeLabel "Commitment",
  has kind "entity",
  has prefLabel "Commitment",
  has definition "A promise made by a single party to one or more parties to do or not do something or act in a particular way.",
  has scopeNote "A commitment is unilateral in that it is binding on only one party. This contrasts with gist:Agreement, which consists of commitments that bind two or more parties.",
  has scopeNote "A single commitment may be made to multiple parties at once; it is a single commitment rather than multiple commitments if the same action would fulfill the obligation to all the parties simultaneously. For example, a performer makes a single commitment to hold a performance to all ticket purchasers; by holding the performance, the commitment to all parties is fulfilled in a single action.",
  has scopeNote "The manner in which a commitment is binding may vary. In a business context, we are typically interested in commitments that are legally binding.",
  has example "Upon selling a treasury bill, the U.S. government makes a commitment to pay the purchaser a stated amount of money at a stated time.",
  has example "When signing an NDA, the signatory commits to keeping specified information confidential.";
put (resource: $r27, module: $gist_core) isa inModule;

put $r28 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Component",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Component",
  has typeLabel "Component",
  has kind "entity",
  has prefLabel "Component",
  has definition "Something that, while having an independent existence, is inherently part of or designed to be part of a larger entity, such as a system or network.",
  has scopeNote "A component may be designed or intended as part of a whole without actually being so; e.g., a car steering wheel that is not installed in any car.",
  has scopeNote "Many things are in a trivial sense a part of a larger thing, but are not considered components because they are not inherently part of that larger thing. For example, while a book may be part of a library (a collection of books), it is not inherently so, and thus is not a component. A playing card, on the other hand, could be considered a component in (member of) a deck of cards. This may be use case-dependent; e.g., car parts might be modeled as components in an automobile manufacturing context but not in a retail auto parts store.",
  has scopeNote "Physical substances, such as ingredients in a cake batter, do not meet the independent existence criterion, so are not components.",
  has scopeNote "This class is not disjoint with gist:Composite, because a component may itself break down into smaller components.",
  has scopeNote "This is an abstract class that is not directly instantiated. Users will define subclasses that are meaningful to their domain of interest.";
put (resource: $r28, module: $gist_core) isa inModule;

put $r29 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Composite",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Composite",
  has typeLabel "Composite",
  has kind "entity",
  has prefLabel "Composite",
  has definition "Something which is made up of various parts or elements that are independently identifiable.",
  has scopeNote "Some composites, like systems, networks, and ordered collections, have internal organization, while others, such as unordered collections, typically do not.",
  has scopeNote "This class is not disjoint with gist:Component, because a composite can itself be a component of a larger composite.",
  has scopeNote "This is an abstract class that will not be directly instantiated.",
  has example "A library (collection of books); a network of pipes and valves; a computer network of routers and computers.";
put (resource: $r29, module: $gist_core) isa inModule;

put $r30 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ContemporaryEvent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ContemporaryEvent",
  has typeLabel "ContemporaryEvent",
  has kind "entity",
  has prefLabel "Contemporary Event",
  has definition "An event that has started but has not yet ended.",
  has scopeNote "When the event actually ends, it will cease being contemporary.";
put (resource: $r30, module: $gist_core) isa inModule;

put $r31 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Content",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Content",
  has typeLabel "Content",
  has kind "entity",
  has prefLabel "Content",
  has definition "Information available in some medium.",
  has scopeNote "Categories are not content until they are written down.",
  has example "A document, program, image.";
put (resource: $r31, module: $gist_core) isa inModule;

put $r32 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ContentExpression",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ContentExpression",
  has typeLabel "ContentExpression",
  has kind "entity",
  has prefLabel "Content Expression",
  has definition "Intellectual property reduced to text, audio, etc.  If it contains text (written or spoken), it will be expressed in a language.";
put (resource: $r32, module: $gist_core) isa inModule;

put $r33 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ContingentEvent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ContingentEvent",
  has typeLabel "ContingentEvent",
  has kind "entity",
  has prefLabel "Contingent Event",
  has definition "An event with a probability of happening in the future, and usually dependent upon some other event or condition.",
  has example "A fire insurance payout is contingent on a particular building burning down; selling 20 shares of stock in a given company is contingent on the price dropping below $200/share; the death benefit payout on a life insurance policy is contingent on the death of the insured person.";
put (resource: $r33, module: $gist_core) isa inModule;

put $r34 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ContingentObligation",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ContingentObligation",
  has typeLabel "ContingentObligation",
  has kind "entity",
  has prefLabel "Contingent Obligation",
  has definition "An obligation that is not yet firm. There is some contingent event whose occurrence will cause the obligation to become firm.",
  has scopeNote "A contingent obligation might have a getter counterparty (as in the case of insurance); but it might not (as in the case of an offer).";
put (resource: $r34, module: $gist_core) isa inModule;

put $r35 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Contract",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Contract",
  has typeLabel "Contract",
  has kind "entity",
  has prefLabel "Contract",
  has definition "An agreement which can be enforced by law.";
put (resource: $r35, module: $gist_core) isa inModule;

put $r36 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ContractTerm",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ContractTerm",
  has typeLabel "ContractTerm",
  has kind "entity",
  has prefLabel "Contract Term",
  has definition "A specification of some aspect of a contract.";
put (resource: $r36, module: $gist_core) isa inModule;

put $r37 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ControlledVocabulary",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ControlledVocabulary",
  has typeLabel "ControlledVocabulary",
  has kind "entity",
  has prefLabel "Controlled Vocabulary",
  has definition "A collection of terms approved and managed by some organization or person.",
  has scopeNote "A controlled vocabulary is similar to a skos:ConceptScheme, but it could also be used for things that are not concepts, such as organizations, US presidents, geographic regions, etc. Hierarchical relationships between instances of the controlled vocabulary are possible.";
put (resource: $r37, module: $gist_core) isa inModule;

put $r38 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/CountryGeoRegion",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/CountryGeoRegion",
  has typeLabel "CountryGeoRegion",
  has kind "entity",
  has prefLabel "Country Geographic Region",
  has definition "A geographic region governed by exactly one country government.";
put (resource: $r38, module: $gist_core) isa inModule;

put $r39 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/CountryGovernment",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/CountryGovernment",
  has typeLabel "CountryGovernment",
  has kind "entity",
  has prefLabel "Country Government",
  has definition "A government organization which asserts both sovereignty (i.e., it is not governed by some other government organization) and governance over an entity generally recognized as a country.",
  has scopeNote "While a country government may enter into treaties with other country governments, there are no governing relationships among the treaty members.";
put (resource: $r39, module: $gist_core) isa inModule;

put $r40 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/DegreeOfCommitment",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/DegreeOfCommitment",
  has typeLabel "DegreeOfCommitment",
  has kind "entity",
  has prefLabel "Degree Of Commitment",
  has definition "The difficulty of reversing a commitment.",
  has example "A car rental typically has a lower degree of commitment than an airfare reservation.";
put (resource: $r40, module: $gist_core) isa inModule;

put $r41 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Determination",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Determination",
  has typeLabel "Determination",
  has kind "entity",
  has prefLabel "Determination",
  has definition "An event whose purpose is to establish a specific result, value, or outcome, usually by research, measuring, evaluating, or calculating.",
  has example "Measuring the sulphur content of crude oil; evaluating a loan application for approval; estimating the price of gas for the next three months; determining whether and by how much an interest rate should change; classifying a purchase into a budget category.";
put (resource: $r41, module: $gist_core) isa inModule;

put $r42 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Discipline",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Discipline",
  has typeLabel "Discipline",
  has kind "entity",
  has prefLabel "Discipline",
  has definition "An area of study or practice.",
  has example "Finance, accounting, project management, acoustics, ballistics.";
put (resource: $r42, module: $gist_core) isa inModule;

put $r43 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ElectronicAddress",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ElectronicAddress",
  has typeLabel "ElectronicAddress",
  has kind "entity",
  has prefLabel "Electronic Address",
  has definition "An address referring to a locatable virtual place that does not physically exist but is made by software or electronics to appear to do so.",
  has example "A file system path, website URL, IP address, email address, mobile or landline telephone number.",
  has altLabel "Virtual Address";
put (resource: $r43, module: $gist_core) isa inModule;

put $r44 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ElectronicAddressType",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ElectronicAddressType",
  has typeLabel "ElectronicAddressType",
  has kind "entity",
  has prefLabel "Electronic Address Type",
  has definition "A category indicating a kind of electronic address. Such a category is usually based on the technology that enables routing to the address referent.",
  has example "A URL, file system path, email address, mobile telephone number.";
put (resource: $r44, module: $gist_core) isa inModule;

put $r45 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Equipment",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Equipment",
  has typeLabel "Equipment",
  has kind "entity",
  has prefLabel "Equipment",
  has definition "Human-made, tangible property other than land or buildings used to perform a task or activity.",
  has example "A machine, a router, a car, a baseball bat.";
put (resource: $r45, module: $gist_core) isa inModule;

put $r46 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/EquipmentType",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/EquipmentType",
  has typeLabel "EquipmentType",
  has kind "entity",
  has prefLabel "Equipment Type",
  has definition "A category of equipment.";
put (resource: $r46, module: $gist_core) isa inModule;

put $r47 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Event",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Event",
  has typeLabel "Event",
  has kind "entity",
  has prefLabel "Event",
  has definition "Something that occurs over a period of time, often characterized as an activity being carried out by some person, organization, or software application or brought about by natural forces.",
  has scopeNote "An event does not necessarily have either planned or actual start or end datetimes. For example, a conference can be in the planning phase without any dates selected, but is nevertheless an (unscheduled) event. The subclasses of gist:Event state particular restrictions on planned and actual start and end dates.",
  has scopeNote "An event occurs during a time interval, which is distinct from the event.",
  has example "A transaction, conference, baseball game, earthquake.";
put (resource: $r47, module: $gist_core) isa inModule;

put $r48 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/EventSpecification",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/EventSpecification",
  has typeLabel "EventSpecification",
  has kind "entity",
  has prefLabel "Event Specification",
  has definition "A characterization of an event that might happen.",
  has scopeNote "This concept is useful for risk assessment and insurance policies.",
  has example "An insurance company defines the characteristics of a weather event that must be satisfied for it to qualify as a hail storm covered in its homeowner's policy; a bank defines the point at which a borrower defaults on a loan.";
put (resource: $r48, module: $gist_core) isa inModule;

put $r49 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/FormattedContent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/FormattedContent",
  has typeLabel "FormattedContent",
  has kind "entity",
  has prefLabel "Formatted Content",
  has definition "Content which is in a particular format.",
  has example "An HTML website, a PDF document, a JPG image.";
put (resource: $r49, module: $gist_core) isa inModule;

put $r50 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Function",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Function",
  has typeLabel "Function",
  has kind "entity",
  has prefLabel "Function",
  has definition "The activity that a human-made item is intended to perform.",
  has example "Transmit electricity, provide ballast, control ambient temperature.";
put (resource: $r50, module: $gist_core) isa inModule;

put $r51 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/GeneralMediaType",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/GeneralMediaType",
  has typeLabel "GeneralMediaType",
  has kind "entity",
  has prefLabel "General Media Type",
  has definition "The real-world media type for content.",
  has example "Audio, still image, video, textual, physical (e.g., a statue), performance (e.g., a play), oil or pastel for a painting.";
put (resource: $r51, module: $gist_core) isa inModule;

put $r52 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation",
  has typeLabel "GeoLocation",
  has kind "entity",
  has prefLabel "Geographic Location",
  has definition "A physical location, with the earth as a frame of reference.",
  has scopeNote "A geographic location may be a point, region, or volume.";
put (resource: $r52, module: $gist_core) isa inModule;

put $r53 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint",
  has typeLabel "GeoPoint",
  has kind "entity",
  has prefLabel "Geographic Point",
  has definition "An individual point on or above the Earth's surface, identified by latitude, longitude and altitude. Altitude is the distance measured from sea level. If altitude is missing, the point is assumed to be at the Earth's surface. These points are described using decimal latitude/longitude.";
put (resource: $r53, module: $gist_core) isa inModule;

put $r54 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/GeoRegion",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/GeoRegion",
  has typeLabel "GeoRegion",
  has kind "entity",
  has prefLabel "Geographic Region",
  has definition "A bounded region (or set of regions) on the surface of the Earth.",
  has scopeNote "A geographic region could be non-contiguous; e.g., the region governed by the US federal government is the contiguous area of the lower 48 states plus Alaska, Hawaii, and overseas territories. Child classes in lower ontologies can make this distinction.",
  has example "The bounded shape that defines the region occupied by Crater Lake; the bounded area known as the contiguous USA.";
put (resource: $r54, module: $gist_core) isa inModule;

put $r55 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/GeoRoute",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/GeoRoute",
  has typeLabel "GeoRoute",
  has kind "entity",
  has prefLabel "Geographic Route",
  has definition "An ordered set of geographic points that defines a path from a starting point to an ending point.",
  has scopeNote "A geographic route could describe a bus route by identifying the points where the bus stops. A geographic route could describe the boundary of a polygonal geographic region (it does not have to be a travelled route).";
put (resource: $r55, module: $gist_core) isa inModule;

put $r56 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/GeoVolume",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/GeoVolume",
  has typeLabel "GeoVolume",
  has kind "entity",
  has prefLabel "Geographic Volume",
  has definition "A three-dimensional space on or near the surface of the Earth, such as an oil reservoir, the body of a lake, or an airspace.";
put (resource: $r56, module: $gist_core) isa inModule;

put $r57 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/GovernedGeoRegion",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/GovernedGeoRegion",
  has typeLabel "GovernedGeoRegion",
  has kind "entity",
  has prefLabel "Governed Geographic Region",
  has definition "A geographic region governed by at least one government organization.",
  has scopeNote "Geographic regions do not need not be physically contiguous in order to constitute a governed geographic region; e.g., Alaska and Hawaii are part of the region governed by the United States.";
put (resource: $r57, module: $gist_core) isa inModule;

put $r58 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/GovernmentOrganization",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/GovernmentOrganization",
  has typeLabel "GovernmentOrganization",
  has kind "entity",
  has prefLabel "Government Organization",
  has definition "An independent organization exercising political and/or regulatory authority over a political unit, people, geographical region, etc., as well as performing certain functions for this unit or body.",
  has scopeNote "Includes administrative, regulatory, and enforcement organizations created or sanctioned by country or sub-country governments.",
  has example "Negative example: A corporation, which is owned and therefore not independent.",
  has example "The State of Washington Office of Financial Management; the Food and Drug Administration; the Scottish Parliament.";
put (resource: $r58, module: $gist_core) isa inModule;

put $r59 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/HistoricalEvent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/HistoricalEvent",
  has typeLabel "HistoricalEvent",
  has kind "entity",
  has prefLabel "Historical Event",
  has definition "An event which occurred in time, with an actual end earlier than the present moment.";
put (resource: $r59, module: $gist_core) isa inModule;

put $r60 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ID",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ID",
  has typeLabel "ID",
  has kind "entity",
  has prefLabel "ID",
  has definition "Content that is used to uniquely identify something or someone.",
  has scopeNote "Used in conjunction with gist:isIdentifiedBy.",
  has example "SSN for a person; serial number for a product; employee ID for a person.";
put (resource: $r60, module: $gist_core) isa inModule;

put $r61 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/IntellectualProperty",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/IntellectualProperty",
  has typeLabel "IntellectualProperty",
  has kind "entity",
  has prefLabel "Intellectual Property",
  has definition "An intangible work, invention, or concept, independent of its being expressed in text, audio, video, image, or live performance. IP can also be tacit knowledge, know-how, or skill.",
  has scopeNote "For literature this could be called the 'Work', except that 'work' is a highly overloaded term (expenditure of energy, resource consumption, art).  Often the first expression precedes our recognition of the IP, but subsequent expressions are known to be derivatives of the IP, even if they are expression-to-expression translations (or copies).",
  has scopeNote "This concept includes works that are out of copyright or were never formally registered; the defining feature is not that it is legally protected but that it is an intangible creation of the human mind.",
  has example "The Old Man and The Sea; the Page Rank algorithm; the brand Coca Cola.";
put (resource: $r61, module: $gist_core) isa inModule;

put $r62 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Intention",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Intention",
  has typeLabel "Intention",
  has kind "entity",
  has prefLabel "Intention",
  has definition "A goal, desire, or aspiration.",
  has scopeNote "The 'teleological' aspect of a system that indicates things are done with a purpose.";
put (resource: $r62, module: $gist_core) isa inModule;

put $r63 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/IntergovernmentalOrganization",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/IntergovernmentalOrganization",
  has typeLabel "IntergovernmentalOrganization",
  has kind "entity",
  has prefLabel "Intergovernmental Organization",
  has definition "An organization whose members are government organizations. This can comprise regional, municipal, state/province, or national level entities.",
  has example "The United Nations, the European Union, the Metropolitan Transit Authority.";
put (resource: $r63, module: $gist_core) isa inModule;

put $r64 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/KnowledgeConcept",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/KnowledgeConcept",
  has typeLabel "KnowledgeConcept",
  has kind "entity",
  has prefLabel "Knowledge Concept",
  has definition "An abstract concept that arises from the distillation of experience. It is similar to a category but, rather than being a simple tag, it has rich structure.",
  has scopeNote "Some knowledge is about specific instances that already exist in the knowledge graph. We may have knowledge that Judge Jones is more lenient on repeat offenders in the morning; we may know that the earliest killing frost in Fort Collins is the last week of September.\n\nThese fit the broader definition of knowledge, the distillation of experience. But they do not require any new instances.  Judge Jones and Fort Collins already exist and have a place in our knowledge graph.\n\nBut some knowledge requires that we synthesize new instances in order to have a place to consolidate the knowledge.  A disease isn't a tangible thing, like a person or a building. A disease is a prediction that a person's health will decline in a predictable way (without treatment and with treatment). The number of diseases continues to grow as we collectively learn more and more granular distinctions. Lung cancer used to be a single disease, but now we have dozens of fine-grained distinctions; e.g., non-lymphoma small cell fusiform is different from alveolar adenocarcinoma because we now know the prognosis and treatment are different.\n\nThis superclass is meant as a place for subclasses that will have the instances that represent the foci of the knowledge we have acquired. Note the distinction between a particular portion of, say, gold, which instantiates gist:PhysicalSubstance, and the concept of gold, which instantiates gist:KnowledgeConcept.\n\nIn some ontologies what we are calling knowledge concepts are defined as classes; e.g., non-lymphoma small cell fusiform and alveolar adenocarcinoma would be two classes rather than two instances. But using a class makes it harder to connect the concept to other instances in a knowledge graph, and furthermore such classes would lack instances.",
  has example "Most domains will define a few subclasses, such as gene, protein, chemical, disease, subject matter, industry, method.";
put (resource: $r64, module: $gist_core) isa inModule;

put $r65 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Landmark",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Landmark",
  has typeLabel "Landmark",
  has kind "entity",
  has prefLabel "Landmark",
  has definition "Something permanently attached to the Earth.",
  has editorialNote "See guidance on removing the term in the next major release at https://github.com/semanticarts/gist/issues/947#issuecomment-1679566885.";
put (resource: $r65, module: $gist_core) isa inModule;

put $r66 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Language",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Language",
  has typeLabel "Language",
  has kind "entity",
  has prefLabel "Language",
  has definition "A recognized, organized set of symbols and grammar.",
  has example "Natural languages such as English and Spanish; computer languages such as OWL, Python, and XML.";
put (resource: $r66, module: $gist_core) isa inModule;

put $r67 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/LivingThing",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/LivingThing",
  has typeLabel "LivingThing",
  has kind "entity",
  has prefLabel "Living Thing",
  has definition "Something that is currently, or at some point in time was, alive.",
  has scopeNote "Not all life forms have exactly two parents, so the restriction only specifies a minimum of one.",
  has example "A cat, a mushroom, a tree.",
  has example "Negative examples: fictional life forms such as unicorns or Mickey Mouse.";
put (resource: $r67, module: $gist_core) isa inModule;

put $r68 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Magnitude",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Magnitude",
  has typeLabel "Magnitude",
  has kind "entity",
  has prefLabel "Magnitude",
  has definition "The amount of a measurable characteristic (aspect).",
  has scopeNote "An accuracy can be assigned to a magnitude using the property has accuracy.",
  has example "A model of car could have a wheelbase of 113.2 inches. In this example, the aspect is wheelbase, the unit of measure is inch, and the numeric value is 113.2.",
  has seeAlso "https://w3id.org/semanticarts/ns/ontology/gist/hasAccuracy";
put (resource: $r68, module: $gist_core) isa inModule;

put $r69 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/MediaType",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/MediaType",
  has typeLabel "MediaType",
  has kind "entity",
  has prefLabel "Media Type",
  has definition "A digitized type that computer applications can recognize.",
  has scopeNote "The unique text for an IANA media type is the concatenation of the 'Type name', a slash '/', and the 'Subtype name' as provided on the page displayed when you resolve the URI of the media type.",
  has example "application/sparql-results+xml",
  has seeAlso "https://www.iana.org/assignments/media-types/media-types.xhtml";
put (resource: $r69, module: $gist_core) isa inModule;

put $r70 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Medium",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Medium",
  has typeLabel "Medium",
  has kind "entity",
  has prefLabel "Medium",
  has definition "A physical material on which a work can be rendered, represented, or implemented.",
  has example "Paper, clay, a computer monitor.";
put (resource: $r70, module: $gist_core) isa inModule;

put $r71 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Message",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Message",
  has typeLabel "Message",
  has kind "entity",
  has prefLabel "Message",
  has definition "A specific instance of content sent from a sender to at least one other recipient.",
  has example "An email, voice, or web service message; a phone call.";
put (resource: $r71, module: $gist_core) isa inModule;

put $r72 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Network",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Network",
  has typeLabel "Network",
  has kind "entity",
  has prefLabel "Network",
  has definition "A composite consisting of nodes connected by links.",
  has example "A physical network could include connected computers or routers, whereas a social network would consist of related person or organization members (or their proxies, such as accounts).";
put (resource: $r72, module: $gist_core) isa inModule;

put $r73 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/NetworkLink",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/NetworkLink",
  has typeLabel "NetworkLink",
  has kind "entity",
  has prefLabel "Network Link",
  has definition "An abstract representation of the connection between two or more nodes in a network.",
  has scopeNote "Each newtork link is connected to a network node via the property gist:links or one of its subproperties.",
  has example "A network link may be physical, such as pipes, wired or wireless networks, but may also be a link in a non-physical network, such as organizational structures or social networks.";
put (resource: $r73, module: $gist_core) isa inModule;

put $r74 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/NetworkNode",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/NetworkNode",
  has typeLabel "NetworkNode",
  has kind "entity",
  has prefLabel "Network Node",
  has definition "A node in a network.",
  has example "A person's account is a node in a social network; a valve is a node in a network of pipes.";
put (resource: $r74, module: $gist_core) isa inModule;

put $r75 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Offer",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Offer",
  has typeLabel "Offer",
  has kind "entity",
  has prefLabel "Offer",
  has definition "A contingent commitment to buy, sell, swap or provide one or more described or identified goods or services in exchange for another (or others).",
  has scopeNote "Dates on an offer represent the time period the offer is valid for, as in '25% off through October 25, 2025'.",
  has example "An offer to sell a book for a given price; an offer to purchase real estate for a particular price; an offer to swap a sea kayak for a mountain bike; currency exchange. A donation may be modeled as an offer to receive money typically in exchange for $0.00, but sometimes for items of value such as coffee mugs or T-shirts.";
put (resource: $r75, module: $gist_core) isa inModule;

put $r76 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/OrderedCollection",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/OrderedCollection",
  has typeLabel "OrderedCollection",
  has kind "entity",
  has prefLabel "Ordered Collection",
  has definition "A collection whose members are ordered in some way.",
  has scopeNote "Includes partially ordered collections as well as collections in which members occupy the same position in a 'tie.' All members of an ordered collection are ordered members.";
put (resource: $r76, module: $gist_core) isa inModule;

put $r77 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember",
  has typeLabel "OrderedMember",
  has kind "entity",
  has prefLabel "Ordered Member",
  has definition "A member of an ordered collection serving as a proxy for a real world item, which can appear in different orders in different collections. The ordered member appears in exactly one ordered collection.",
  has scopeNote "An ordered member points to the real world item via the providesOrderFor property. Ordering information is represented either as a number in a sequence, or by preceding or following another ordered member.",
  has example "A person may rank 12th in the Boston Marathon but 29th in the New York City Marathon.";
put (resource: $r77, module: $gist_core) isa inModule;

put $r78 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Organization",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Organization",
  has typeLabel "Organization",
  has kind "entity",
  has prefLabel "Organization",
  has definition "A structured entity formed to achieve specific goals, typically involving members with defined roles.",
  has scopeNote "Not all organizations have members, e.g. shell companies.",
  has scopeNote "While typically the members of organizations are people, in some cases they are other organizations; e.g., the members of the United Nations are country governments.",
  has example "Legal entities like companies; non-legal entities like clubs, committees, or departments.";
put (resource: $r78, module: $gist_core) isa inModule;

put $r79 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Permission",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Permission",
  has typeLabel "Permission",
  has kind "entity",
  has prefLabel "Permission",
  has definition "A description of things one is permitted to do.",
  has example "Permission could be broad, such as free speech, but more often is very specific, such as the right to enter a particular property.";
put (resource: $r79, module: $gist_core) isa inModule;

put $r80 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Person",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Person",
  has typeLabel "Person",
  has kind "entity",
  has prefLabel "Person",
  has definition "A human being who was or is alive.",
  has example "Negative example: fictional characters.";
put (resource: $r80, module: $gist_core) isa inModule;

put $r81 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalActionType",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalActionType",
  has typeLabel "PhysicalActionType",
  has kind "entity",
  has prefLabel "Physical Action Type",
  has definition "A category indicating the type of an action based on its effect in the physical world.",
  has example "Lifting a garage door, turning off a valve, dropping cadmium rods.";
put (resource: $r81, module: $gist_core) isa inModule;

put $r82 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalAddress",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalAddress",
  has typeLabel "PhysicalAddress",
  has kind "entity",
  has prefLabel "Physical Address",
  has definition "An address that refers to a locatable place within the physical universe.",
  has example "1600 Pennsylvania Avenue NW, Washington, DC 20500; PO Box 7704, San Francisco, CA 94120-7704; Room 317 in the Louvre Museum.";
put (resource: $r82, module: $gist_core) isa inModule;

put $r83 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalAddressType",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalAddressType",
  has typeLabel "PhysicalAddressType",
  has kind "entity",
  has prefLabel "Physical Address Type",
  has definition "A category indicating local customary characterizations of physical addresses.",
  has example "Street address, PO box, FPO code.";
put (resource: $r83, module: $gist_core) isa inModule;

put $r84 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalEvent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalEvent",
  has typeLabel "PhysicalEvent",
  has kind "entity",
  has prefLabel "Physical Event",
  has definition "An event that can be said to have occurred at some place in space.",
  has example "A meeting, a car accident.",
  has example "Negative examples: Excludes events that have no meaningful location, such as financial events or project milestones.";
put (resource: $r84, module: $gist_core) isa inModule;

put $r85 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem",
  has typeLabel "PhysicalIdentifiableItem",
  has kind "entity",
  has prefLabel "Physical Identifiable Item",
  has definition "A discrete physical object which, if subdivided, will result in parts that are distinguishable in nature from the whole and in general also from the other parts.",
  has scopeNote "This concept generally corresponds to count nouns in English. By contrast, physical substances, such as an amount of water, flour, or sand, are mass nouns. Physical identifiable items are made up of physical substances; e.g., a cake is made up of butter, flour, and sugar; a statue is made of bronze. If you divide a physical substance such as an amount of water into parts, you have two amounts of water otherwise indistinguishable from one another; if you divide a physical identifiable item such as a computer into parts, each part is different from the whole.",
  has example "A computer, a book, a car.";
put (resource: $r85, module: $gist_core) isa inModule;

put $r86 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance",
  has typeLabel "PhysicalSubstance",
  has kind "entity",
  has prefLabel "Physical Substance",
  has definition "An undifferentiated amount of physical material which, when subdivided, results in each part being indistinguishable in nature from the whole and from every other part.",
  has scopeNote "An instance of this class has weight and takes up space. We mean the physical gold in a ring, not the concept of gold that shows up in the periodic table. The latter would be an instance of gist:KnowledgeConcept.",
  has scopeNote "This concept generally corresponds to mass nouns in English. By contrast, instances of PhysicalIdentifiableItem, such as a computer, book, or car, are count nouns. PhysicalIdentifiableItems are made up of PhysicalSubstances; e.g., a cake is made up of butter, flour, and sugar; a ring is made of gold. If you divide a PhysicalSubstance such as an amount of water into parts, you have different amounts of water otherwise indistinguishable from one another; if you divide a PhysicalIdentifiableItem such as a computer into parts, each part will be distinguishable from the original whole.",
  has example "An amount of water, penicillin, sand, or gold.",
  has example "Negative example: the concept of gold.";
put (resource: $r86, module: $gist_core) isa inModule;

put $r87 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ProductCategory",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ProductCategory",
  has typeLabel "ProductCategory",
  has kind "entity",
  has prefLabel "Product Category",
  has definition "Any of many ways of categorizing products.",
  has example "Automobile models, NATO product codes.";
put (resource: $r87, module: $gist_core) isa inModule;

put $r88 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ProductSpecification",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ProductSpecification",
  has typeLabel "ProductSpecification",
  has kind "entity",
  has prefLabel "Product Specification",
  has definition "Offering something which could be physically warehoused or digitally stored.";
put (resource: $r88, module: $gist_core) isa inModule;

put $r89 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Project",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Project",
  has typeLabel "Project",
  has kind "entity",
  has prefLabel "Project",
  has definition "A task, usually of longer duration, made up of other tasks.",
  has example "Designing an insurance product; adding a new feature to a software application; assessing the level of risk for a mortgage application.";
put (resource: $r89, module: $gist_core) isa inModule;

put $r90 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ReferenceValue",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ReferenceValue",
  has typeLabel "ReferenceValue",
  has kind "entity",
  has prefLabel "Reference Value",
  has definition "A magnitude that was neither measured nor estimated but set by fiat.",
  has example "The sales goal for a company.";
put (resource: $r90, module: $gist_core) isa inModule;

put $r91 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/RenderedContent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/RenderedContent",
  has typeLabel "RenderedContent",
  has kind "entity",
  has prefLabel "Rendered Content",
  has definition "Content which has been physically expressed.",
  has example "Words printed on paper; audio played on speakers; images displayed on monitors.";
put (resource: $r91, module: $gist_core) isa inModule;

put $r92 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Requirement",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Requirement",
  has typeLabel "Requirement",
  has kind "entity",
  has prefLabel "Requirement",
  has definition "The obligation of a person or organization to behave in a certain way.",
  has example "In the US, drivers must drive on the right side of the road.";
put (resource: $r92, module: $gist_core) isa inModule;

put $r93 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Restriction",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Restriction",
  has typeLabel "Restriction",
  has kind "entity",
  has prefLabel "Restriction",
  has definition "A description of things one is prevented from doing.",
  has example "In the US, tax laws restrict the amount of money a person can put in retirement accounts over the course of a year.";
put (resource: $r93, module: $gist_core) isa inModule;

put $r94 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ScheduledEvent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ScheduledEvent",
  has typeLabel "ScheduledEvent",
  has kind "entity",
  has prefLabel "Scheduled Event",
  has definition "An event with a planned start datetime.",
  has scopeNote "If the event already started, but has not yet ended, it is a contemporary event with an actual start datetime. If the event is over, it is a historical event having an actual end datetime. The event always retains its planned start datetime, and thus continues to be a scheduled event.";
put (resource: $r94, module: $gist_core) isa inModule;

put $r95 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ScheduledTask",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ScheduledTask",
  has typeLabel "ScheduledTask",
  has kind "entity",
  has prefLabel "Scheduled Task",
  has definition "A task with a planned start datetime.",
  has scopeNote "If work on the task has already started, but has not yet ended, it will have an actual start datetime. If the task is completed, it will also have an actual end datetime. The task always retains its planned start time, and thus continues to be a scheduled task.";
put (resource: $r95, module: $gist_core) isa inModule;

put $r96 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/SchemaMetaData",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/SchemaMetaData",
  has typeLabel "SchemaMetaData",
  has kind "entity",
  has prefLabel "Schema Meta Data",
  has definition "Superclass for all types of metadata.",
  has scopeNote "The definition of this class needs additional work.",
  has example "Relational concepts, such as tables and columns; tool inputs, such as queries and R2RML maps.";
put (resource: $r96, module: $gist_core) isa inModule;

put $r97 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/ServiceSpecification",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/ServiceSpecification",
  has typeLabel "ServiceSpecification",
  has kind "entity",
  has prefLabel "Service Specification",
  has definition "A description of something that can be done for a person or organization (which produces some form of an act).";
put (resource: $r97, module: $gist_core) isa inModule;

put $r98 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Specification",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Specification",
  has typeLabel "Specification",
  has kind "entity",
  has prefLabel "Specification",
  has definition "One or more characteristics that specify what it means to be a particular type of thing, such as a material, product, service or event. A specification is sufficiently precise to allow evaluating conformance to the specification.",
  has scopeNote "Although a characterization of how to do something is often called a specification, the intended meaning here is limited to specifying what something is. The focus is on the what, not the how. Use gist:TaskTemplate for specifying the how, such as a plan or process specification.",
  has example "The specification of the iPhone 14; hypothetical events covered by a homeowner's insurance policy.";
put (resource: $r98, module: $gist_core) isa inModule;

put $r99 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/SubCountryGovernment",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/SubCountryGovernment",
  has typeLabel "SubCountryGovernment",
  has kind "entity",
  has prefLabel "Sub-Country Government",
  has definition "The government of a governed geographic region other than a country which is under the direct or indirect control of a country government.",
  has scopeNote "Note that the predicate gist:isGovernedBy is used both for the relationship a governed geographic region has to its government and for the relationship a sub-region government has to the government of the larger region.",
  has scopeNote "There are many types of sub-regions of a country and the governments thereof (as well as different terms, like 'province' and 'state,' which refer to essentially the same type of thing). We should not automatically assume 'state,' 'county,' and 'city.' Subclasses or categories can be defined if greater specificity is needed.",
  has scopeNote "This class applies only to organizations governing geographic regions. Regulatory and bureaucratic organizations are members of the more generic gist:GovernmentOrganization class.";
put (resource: $r99, module: $gist_core) isa inModule;

put $r100 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/System",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/System",
  has typeLabel "System",
  has kind "entity",
  has prefLabel "System",
  has definition "A composite with component parts that contribute to the goal of the system.";
put (resource: $r100, module: $gist_core) isa inModule;

put $r101 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Tag",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Tag",
  has typeLabel "Tag",
  has kind "entity",
  has prefLabel "Tag",
  has definition "A term in a folksonomy used to categorize things. Tags can be made up on the fly by users.",
  has scopeNote "Whether to use gist:containedText or gist:uniqueText on tags is an implementation decision. Since the latter is a subproperty of the former, the restriction remains valid either way.";
put (resource: $r101, module: $gist_core) isa inModule;

put $r102 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Task",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Task",
  has typeLabel "Task",
  has kind "entity",
  has prefLabel "Task",
  has definition "An activity or piece of work that is either proposed, planned, scheduled, underway, or completed.",
  has scopeNote "Something that could potentially be executed, which is merely described but not proposed in any specific way, such as a business process for onboarding a new employee, or the steps in a recipe for making polyethylene from ethylene, is not a task but rather a task template.",
  has scopeNote "This term is broader than the English word 'task,' which implies assignment, responsibility, or duty. In ordinary English going to a concert has a goal but is (generally) done for pleasure rather than out of obligation, and would not be considered a task, while according to the gist definition it is a task. The expansion of meaning is deliberate, so that anything that has a goal and can be specified by a task template is a task.",
  has scopeNote "Use the property gist:isBasedOn to link a task back to the task template.";
put (resource: $r102, module: $gist_core) isa inModule;

put $r103 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/TaskTemplate",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/TaskTemplate",
  has typeLabel "TaskTemplate",
  has kind "entity",
  has prefLabel "Task Template",
  has definition "An outline of a task of a particular type, which is the basis for executing such tasks.",
  has scopeNote "A task template may define a single activity or a series of activities; the level of granularity can be varied according to use case. For example, in a new employee onboarding process, signing up for benefits might be one activity, or it might be broken down into signing up for health insurance, signing up for dental insurance, etc.",
  has scopeNote "Use the property isBasedOn to link the Task back to the TaskTemplate.",
  has example "A business process for onboarding new employees.";
put (resource: $r103, module: $gist_core) isa inModule;

put $r104 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Template",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Template",
  has typeLabel "Template",
  has kind "entity",
  has prefLabel "Template",
  has definition "Something used to make objects in its own image.",
  has scopeNote "Use gist:isBasedOn to link the object made from the template back to the template.",
  has example "A die in manufacturing is used to make stamped parts; a form provides a structure and fields to be filled in; a cookie cutter is a template for cookies.";
put (resource: $r104, module: $gist_core) isa inModule;

put $r105 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/TemporalRelation",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/TemporalRelation",
  has typeLabel "TemporalRelation",
  has kind "entity",
  has prefLabel "Temporal Relation",
  has definition "A relationship existing for a period of time.",
  has scopeNote "A temporal relation must have a minimum of two participants. For example, both the employer and the employee are participants in a temporal relation representing a period of employment. Note that 'participant' does not imply agency; a non-sentient being can participate in a temporal relation. For example, both a person and a house could be participants in a hypothetical relation 'lives at.'",
  has example "The relationship between a person and their employer; the relationship between a person or business and an address.";
put (resource: $r105, module: $gist_core) isa inModule;

put $r106 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Text",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Text",
  has typeLabel "Text",
  has kind "entity",
  has prefLabel "Text",
  has definition "Content expressed as words and numbers.",
  has example "Negative example: graphical content.";
put (resource: $r106, module: $gist_core) isa inModule;

put $r107 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/TimeInterval",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/TimeInterval",
  has typeLabel "TimeInterval",
  has kind "entity",
  has prefLabel "Time Interval",
  has definition "A span of time with a known start time, end time, and duration. As long as two of the three are known, the third can be inferred.",
  has scopeNote "An ongoing state of affairs with an unknown end time in the future cannot be a time interval; e.g. the lifespan of a living person cannot be a time interval, as the end time is unknown.",
  has scopeNote "This is distinct from a duration, which describes how long a time interval lasts (e.g., one hour; 3 days; 22 minutes).",
  has example "7pm to 9pm on Jan 1, 2001; fiscal year 2023 (according to some particular definition of fiscal year); the week starting at midnight of January 12, 2023 and lasting exactly 168 hours.";
put (resource: $r107, module: $gist_core) isa inModule;

put $r108 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/Transaction",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/Transaction",
  has typeLabel "Transaction",
  has kind "entity",
  has prefLabel "Transaction",
  has definition "An exchange or transfer of goods, services, or funds.",
  has scopeNote "Different sorts of transactions can have different datetime precisions. For example, an electronic transaction would have a gist:actualEndMicrosecond.";
put (resource: $r108, module: $gist_core) isa inModule;

put $r109 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup",
  has typeLabel "UnitGroup",
  has kind "entity",
  has prefLabel "Unit Group",
  has definition "A collection of units of measure that can all be used to measure the same aspects.",
  has scopeNote "Typically there is one unit group per aspect. An example of an aspect with two unit groups is vehicle efficiency, which can be measured by miles per gallon (distance per volume) or by liters per 100 kilometers (volume per distance). These two units of measure need to be in different unit groups because they have different values of exponents. When adding a unit of measure to a unit group, make sure it has the same exponents as the other members of the unit group.",
  has example "The units of measure bit, byte, kilobit, kilobyte, etc. are all in the same unit group because they can all be used to measure an amount of data.";
put (resource: $r109, module: $gist_core) isa inModule;

put $r110 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure",
  has typeLabel "UnitOfMeasure",
  has kind "entity",
  has prefLabel "Unit of Measure",
  has definition "A standard amount used to measure or specify things.",
  has example "An acre is a unit for measuring area.";
put (resource: $r110, module: $gist_core) isa inModule;

put $r111 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/allows",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/allows",
  has typeLabel "allows",
  has kind "relation",
  has prefLabel "allows",
  has definition "Relates a permission to a particular activity or type of activity it allows.",
  has example "An easement grants a right to cross or otherwise use someone else's land for a specified purpose.";
put (resource: $r111, module: $gist_core) isa inModule;

put $r112 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/comesFromAgent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/comesFromAgent",
  has typeLabel "comesFromAgent",
  has kind "relation",
  has prefLabel "comes from agent",
  has definition "Relates something to the originating agent.",
  has scopeNote "This is not the inverse of gist:goesToAgent, as both properties have the message or shipment as the subject.",
  has scopeNote "This property is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another, whereas gist:hasGiver is typically used in more abstract contexts such as agreements, obligations, contracts, etc. However, there are contexts in which either may be appropriate, such as the giving of a gift.",
  has example "A package is shipped by a person; a purchase order is emailed to a vendor by an organization.";
put (resource: $r112, module: $gist_core) isa inModule;

put $r113 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/comesFromPlace",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/comesFromPlace",
  has typeLabel "comesFromPlace",
  has kind "relation",
  has prefLabel "comes from place",
  has definition "Relates something to its place of origin.",
  has example "A letter has a return address indicating its origin; a delivery route originates at a distribution center; a trail originates at the trailhead.";
put (resource: $r113, module: $gist_core) isa inModule;

put $r114 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/conformsTo",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/conformsTo",
  has typeLabel "conformsTo",
  has kind "relation",
  has prefLabel "conforms to",
  has definition "The subject is consistent with or satisfies the requirements, rules, or expectations established by the object.",
  has example "Meet an obligation; adhere to a specification or standard; meet terms and conditions of an offer; comply with a regulation.";
put (resource: $r114, module: $gist_core) isa inModule;

put $r115 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/contributesTo",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/contributesTo",
  has typeLabel "contributesTo",
  has kind "relation",
  has prefLabel "contributes to",
  has definition "Relates a part of a system to the system whose goals or function it contributes to.";
put (resource: $r115, module: $gist_core) isa inModule;

put $r116 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/goesToAgent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/goesToAgent",
  has typeLabel "goesToAgent",
  has kind "relation",
  has prefLabel "goes to agent",
  has definition "Relates something to the agent that receives it.",
  has scopeNote "This is not the inverse of gist:comesFromAgent, as both properties have the message or shipment as the subject.",
  has scopeNote "This property is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another, whereas gist:hasRecipient is typically used in more abstract contexts such as agreements, obligations, contracts, etc. However, there are contexts in which either may be appropriate, such as the recieving of a gift.",
  has example "A package is sent to a person; a purchase order email is received by a vendor.";
put (resource: $r116, module: $gist_core) isa inModule;

put $r117 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/goesToPlace",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/goesToPlace",
  has typeLabel "goesToPlace",
  has kind "relation",
  has prefLabel "goes to place",
  has definition "Relates something to its destination place.",
  has example "A letter has an address indicating its destination; a segment of a delivery route terminates at a delivery location; a trail terminates at an intersection with another trail.";
put (resource: $r117, module: $gist_core) isa inModule;

put $r118 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasAccuracy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasAccuracy",
  has typeLabel "hasAccuracy",
  has kind "relation",
  has prefLabel "has accuracy",
  has definition "Relates a magnitude to another magnitude that describes its accuracy.",
  has scopeNote "gist uses the ISO-5725 definition of accuracy, which is a combination of trueness (a measure of systemic error) and precision (a measure of random error). The accuracy of a measurement method describes how close its measurements are to actual values. Similarly, the accuracy of an individual measurement is its likely closeness to the actual value. When we say a temperature measurement is accurate to within a tenth of a degree, it means with a certain probability such as 95%.\n\nNote that the unit of measure of the accuracy has to be compatible with the unit of measure of the original magnitude (e.g. something measured in meters could have a accuracy in terms of millimeters or any other unit that measures distance).",
  has example "Temperature accurate to tenth of a degree C; length accurate to the nearest centimeter.",
  has seeAlso "https://en.wikipedia.org/wiki/Accuracy_and_precision",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Magnitude";
put (resource: $r118, module: $gist_core) isa inModule;

put $r119 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasAddend",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasAddend",
  has typeLabel "hasAddend",
  has kind "relation",
  has prefLabel "has addend",
  has definition "Relates an aspect to another aspect that is an additive component of it.",
  has scopeNote "Commonly used with financial metrics.",
  has example "In the equation 'profit = revenue - expenses', revenue is an addend and expenses is a subtrahend.";
put (resource: $r119, module: $gist_core) isa inModule;

put $r120 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasAddress",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasAddress",
  has typeLabel "hasAddress",
  has kind "relation",
  has prefLabel "has address",
  has definition "Relates something to its physical or electronic address.",
  has example "A brick-and-mortar store has a street address; a person can be contacted electronically via an email address.";
put (resource: $r120, module: $gist_core) isa inModule;

put $r121 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasAspect",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasAspect",
  has typeLabel "hasAspect",
  has kind "relation",
  has prefLabel "has aspect",
  has definition "Relates a magnitude to its aspect (measurable characteristic).";
put (resource: $r121, module: $gist_core) isa inModule;

put $r122 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent",
  has typeLabel "hasBiologicalParent",
  has kind "relation",
  has prefLabel "has biological parent",
  has definition "Relates a living thing to its biological parent.";
put (resource: $r122, module: $gist_core) isa inModule;

put $r123 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasBroader",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasBroader",
  has typeLabel "hasBroader",
  has kind "relation",
  has prefLabel "has broader",
  has definition "Relates a thing to another thing with a broader meaning.",
  has example "The aspect distance is broader than the aspect height.";
put (resource: $r123, module: $gist_core) isa inModule;

put $r124 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasDirectBroader",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasDirectBroader",
  has typeLabel "hasDirectBroader",
  has kind "relation",
  has prefLabel "has direct broader",
  has definition "Relates a thing to another thing with a broader meaning, when there is no intermediate between them.",
  has scopeNote "Unlike gist:hasBroader, this property is not transitive. It is safest to use this property when semantic directness is inherent in the relationship. Otherwise, there is a risk of making a hasDirectBroader assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:hasBroader.";
put (resource: $r124, module: $gist_core) isa inModule;

put $r125 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasDivisor",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasDivisor",
  has typeLabel "hasDivisor",
  has kind "relation",
  has prefLabel "has divisor",
  has definition "Relates a unit of measure to another unit of measure that is a divisor, or relates an aspect to another aspect that is a divisor.",
  has scopeNote "Provides a supplemental method of decomposing a unit of measure or an aspect into component factors. Enables dimensional analysis such as miles per hour x hours = miles.",
  has example "Miles per hour has miles as a multiplier and hour as a divisor; speed has distance as a multiplier and duration as a divisor.";
put (resource: $r125, module: $gist_core) isa inModule;

put $r126 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasGiver",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasGiver",
  has typeLabel "hasGiver",
  has kind "relation",
  has prefLabel "has giver",
  has definition "Relates something to the participant that provides it.",
  has scopeNote "This property is often used in abstract contexts such as agreements, obligations, contracts, etc., whereas gist:comesFromAgent is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another. However, there are contexts in which either may be appropriate, such as the giving of a gift.",
  has example "An offer is made by a giver; an obligation has a giver who is obligated to another person; a gift is presented by the giver.";
put (resource: $r126, module: $gist_core) isa inModule;

put $r127 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasGoal",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasGoal",
  has typeLabel "hasGoal",
  has kind "relation",
  has prefLabel "has goal",
  has definition "Relates something to the end towards which it directs effort.",
  has example "The sales division of a company has the goal of acquiring new customers and contracts.";
put (resource: $r127, module: $gist_core) isa inModule;

put $r128 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasIncumbent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasIncumbent",
  has typeLabel "hasIncumbent",
  has kind "relation",
  has prefLabel "has incumbent",
  has definition "Relates a position to the thing or person that currently holds that position.",
  has scopeNote "To create a temporal view, define a subclass of gist:TemporalRelation for this property (e.g., Incumbency).";
put (resource: $r128, module: $gist_core) isa inModule;

put $r129 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude",
  has typeLabel "hasMagnitude",
  has kind "relation",
  has prefLabel "has magnitude",
  has definition "Relates a thing to a magnitude.",
  has example "A car or model of car has magnitudes for length, width, weight, average miles per gallon, etc.";
put (resource: $r129, module: $gist_core) isa inModule;

put $r130 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasMultiplier",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasMultiplier",
  has typeLabel "hasMultiplier",
  has kind "relation",
  has prefLabel "has multiplier",
  has definition "Relates a unit of measure to another unit of measure that is a factor, or relates an aspect to another aspect that is a factor.",
  has scopeNote "Provides a supplemental method of decomposing a unit of measure or aspect into component factors. Enables dimensional analysis such as miles per hour x hours = miles.",
  has example "Miles per hour has miles as a multiplier and hours as a divisor; speed has distance as a multiplier and duration as a divisor.";
put (resource: $r130, module: $gist_core) isa inModule;

put $r131 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasNavigationalParent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasNavigationalParent",
  has typeLabel "hasNavigationalParent",
  has kind "relation",
  has prefLabel "has navigational parent",
  has definition "Relates a child category to a parent category in an informal (e.g., faceted) hierarchy.",
  has example "Refrigerator handles are not refrigerators, but it may be useful to represent their relationship hierarchically for a faceted UI filter.";
put (resource: $r131, module: $gist_core) isa inModule;

put $r132 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant",
  has typeLabel "hasParticipant",
  has kind "relation",
  has prefLabel "has participant",
  has definition "Relates something (e.g. an agreement) to things that play a role, or take part or are otherwise involved in some way.",
  has scopeNote "The thing with participants will often be an agreement, event or obligation. Participation does not imply agency.",
  has scopeNote "This will most often be used as an abstract property. Use subproperties that indicate the nature of the participation (e.g. hasBorrower, hasVenue).",
  has example "An event of transferring money has a participating account that receives the money.";
put (resource: $r132, module: $gist_core) isa inModule;

put $r133 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasParty",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasParty",
  has typeLabel "hasParty",
  has kind "relation",
  has prefLabel "has party",
  has definition "Relates an event, agreement, or obligation to a participating person or organization.",
  has scopeNote "Subproperties may be defined to describe specific parties, such as hasLender and hasBorrower for a loan.",
  has example "Loan agreements have lender and borrower parties.";
put (resource: $r133, module: $gist_core) isa inModule;

put $r134 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasPhysicalLocation",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasPhysicalLocation",
  has typeLabel "hasPhysicalLocation",
  has kind "relation",
  has prefLabel "has physical location",
  has definition "Relates something to its physical location.",
  has scopeNote "This property does not distinguish between things whose locations are stable and those whose locations change over time; e.g., a fire hydrant vs. a car.";
put (resource: $r134, module: $gist_core) isa inModule;

put $r135 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasRecipient",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasRecipient",
  has typeLabel "hasRecipient",
  has kind "relation",
  has prefLabel "has recipient",
  has definition "Relates something to the participant that receives or is intended to receive it.",
  has scopeNote "This property is used in abstract contexts such as agreements, obligations, contracts, etc., whereas gist:goesToAgent is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another. However, there are contexts in which either may be appropriate, such as the giving of a gift.",
  has example "An offer is made to a recipient; an obligation has a recipient to whom another person is obligated; a gift is bestowed upon a recipient.";
put (resource: $r135, module: $gist_core) isa inModule;

put $r136 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasSubtrahend",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasSubtrahend",
  has typeLabel "hasSubtrahend",
  has kind "relation",
  has prefLabel "has subtrahend",
  has definition "Relates an aspect to another aspect that is a subtracted component of it.",
  has scopeNote "Commonly used with financial metrics.",
  has example "In the equation 'profit = revenue - expenses', revenue is an addend and expenses is a subtrahend.";
put (resource: $r136, module: $gist_core) isa inModule;

put $r137 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasUniqueBroader",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasUniqueBroader",
  has typeLabel "hasUniqueBroader",
  has kind "relation",
  has prefLabel "has unique broader",
  has definition "Relates a thing to a unique other thing with a broader meaning.";
put (resource: $r137, module: $gist_core) isa inModule;

put $r138 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasUniqueNavigationalParent",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasUniqueNavigationalParent",
  has typeLabel "hasUniqueNavigationalParent",
  has kind "relation",
  has prefLabel "has unique navigational parent",
  has definition "Relates a subject category to a unique parent category in an informal (e.g., faceted) hierarchy.";
put (resource: $r138, module: $gist_core) isa inModule;

put $r139 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasUnitGroup",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasUnitGroup",
  has typeLabel "hasUnitGroup",
  has kind "relation",
  has prefLabel "has unit group",
  has definition "Relates an aspect to a unit group. The aspect can be measured using any of the members of the unit group.",
  has example "The aspect distance can have a unit group that includes the units meter, inch, foot, etc.";
put (resource: $r139, module: $gist_core) isa inModule;

put $r140 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/hasUnitOfMeasure",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/hasUnitOfMeasure",
  has typeLabel "hasUnitOfMeasure",
  has kind "relation",
  has prefLabel "has unit of measure",
  has definition "Relates a magnitude to its unit of measure.",
  has example "The magnitude 87 inches of height has unit of measure inches.";
put (resource: $r140, module: $gist_core) isa inModule;

put $r141 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isAbout",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isAbout",
  has typeLabel "isAbout",
  has kind "relation",
  has prefLabel "is about",
  has definition "Subject matter of a document.";
put (resource: $r141, module: $gist_core) isa inModule;

put $r142 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isAffectedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isAffectedBy",
  has typeLabel "isAffectedBy",
  has kind "relation",
  has prefLabel "is affected by",
  has definition "Relates an affected thing to the source of the effect.";
put (resource: $r142, module: $gist_core) isa inModule;

put $r143 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isAllocatedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isAllocatedBy",
  has typeLabel "isAllocatedBy",
  has kind "relation",
  has prefLabel "is allocated by",
  has definition "Relates something to whomever or whatever assigns or distributes it.",
  has scopeNote "The allocator may be a person, organization, or automated process.",
  has example "A U.S. Social Security number is allocated by the U.S. Social Security Administration; the media type https://www.iana.org/assignments/media-types/text/csv is allocated by the Internet Assigned Numbers Authority (IANA).",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Category",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/ID";
put (resource: $r143, module: $gist_core) isa inModule;

put $r144 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentOf",
  has typeLabel "isAssignmentOf",
  has kind "relation",
  has prefLabel "is assignment of",
  has definition "Relates an assignment to the resource it assigns.",
  has scopeNote "People, organizations, monetary amounts, equipment can all be assigned.",
  has scopeNote "While typically this predicate will be used with assignment subjects, there may be other use cases, and therefore a domain is not specified.",
  has example "Assignment of a person to a project.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Assignment";
put (resource: $r144, module: $gist_core) isa inModule;

put $r145 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentTo",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentTo",
  has typeLabel "isAssignmentTo",
  has kind "relation",
  has prefLabel "is assignment to",
  has definition "Relates something (typically an assignment) to the thing the resource is assigned to, such as a project, position, organization, pay rate, or billing rate.",
  has scopeNote "While typically this predicate will be used with gist:Assignment subjects, there may be other use cases, and therefore a domain is not specified.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Assignment";
put (resource: $r145, module: $gist_core) isa inModule;

put $r146 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isBasedOn",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isBasedOn",
  has typeLabel "isBasedOn",
  has kind "relation",
  has prefLabel "is based on",
  has definition "The object is a foundation for, a starting point for, gave rise to, or justifies the subject.",
  has example "A document is based on a document template; a metric computing the average income of a population is based on the metric for individual income.";
put (resource: $r146, module: $gist_core) isa inModule;

put $r147 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy",
  has typeLabel "isCategorizedBy",
  has kind "relation",
  has prefLabel "is categorized by",
  has definition "Relates something to a taxonomy term or other less formally defined classification.";
put (resource: $r147, module: $gist_core) isa inModule;

put $r148 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isConnectedTo",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isConnectedTo",
  has typeLabel "isConnectedTo",
  has kind "relation",
  has prefLabel "is connected to",
  has definition "A non-owning, non-causal, non-subordinate (i.e., peer-to-peer) relationship.";
put (resource: $r148, module: $gist_core) isa inModule;

put $r149 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf",
  has typeLabel "isDirectPartOf",
  has kind "relation",
  has prefLabel "is direct part of",
  has definition "The relationship between a part and a whole where the part has independent existence and there are no other parts in between.",
  has scopeNote "Because the part has independent existence, there is no cascading delete.",
  has scopeNote "It is safest to use this property when semantic directness is inherent in the relationship, rather than simply expressing a chosen granularity. For example, a spark plug is a direct part of an engine block; there cannot be any intermediate parts. Otherwise, there is a risk of making an isDirectPartOf assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:isPartOf.";
put (resource: $r149, module: $gist_core) isa inModule;

put $r150 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isExpressedIn",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isExpressedIn",
  has typeLabel "isExpressedIn",
  has kind "relation",
  has prefLabel "is expressed in",
  has definition "Relates something to the language it is expressed in.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Text";
put (resource: $r150, module: $gist_core) isa inModule;

put $r151 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isFirstMemberOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isFirstMemberOf",
  has typeLabel "isFirstMemberOf",
  has kind "relation",
  has prefLabel "is first member of",
  has definition "Relates the first member of an ordered collection to the collection.",
  has scopeNote "Given the Open World Assumption, the absence of a predecessor does not entail that an ordered member is the first member of an ordered collection. This property is used to explicitly indicate the first member. Since ordered collections need not be strictly ordered, there can be more than one first member.";
put (resource: $r151, module: $gist_core) isa inModule;

put $r152 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isGeoContainedIn",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isGeoContainedIn",
  has typeLabel "isGeoContainedIn",
  has kind "relation",
  has prefLabel "is geographically contained in",
  has definition "Relates one geographic location to another that contains it.";
put (resource: $r152, module: $gist_core) isa inModule;

put $r153 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy",
  has typeLabel "isGovernedBy",
  has kind "relation",
  has prefLabel "is governed by",
  has definition "Relates an entity to another entity that controls, directs, determines or has a guiding influence or authority over it.",
  has example "A country geographic region is governed by a country government; the installation and use of software is governed by a license.";
put (resource: $r153, module: $gist_core) isa inModule;

put $r154 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isIdentifiedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isIdentifiedBy",
  has typeLabel "isIdentifiedBy",
  has kind "relation",
  has prefLabel "is identified by",
  has definition "Relates something to a content object that uniquely identifies it.",
  has scopeNote "This is like a URI: a thing can have more than one ID, but each ID can refer to only one thing. Note that it is possible to have two IDs with the same text that refer to different things.";
put (resource: $r154, module: $gist_core) isa inModule;

put $r155 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isMadeUpOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isMadeUpOf",
  has typeLabel "isMadeUpOf",
  has kind "relation",
  has prefLabel "is made up of",
  has definition "Relates something to a substance that it is made up of.",
  has example "A vase is made of clay; water is made up of hydrogen and oxygen.";
put (resource: $r155, module: $gist_core) isa inModule;

put $r156 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf",
  has typeLabel "isMemberOf",
  has kind "relation",
  has prefLabel "is member of",
  has definition "Relates a member individual to the thing, such as a collection or organization, that it is a member of.";
put (resource: $r156, module: $gist_core) isa inModule;

put $r157 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isPartOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isPartOf",
  has typeLabel "isPartOf",
  has kind "relation",
  has prefLabel "is part of",
  has definition "The relationship between a part and a whole where the part has independent existence.",
  has scopeNote "Because the part has independent existence, there is no cascading delete.",
  has scopeNote "The transitive version of gist:isDirectPartOf.";
put (resource: $r157, module: $gist_core) isa inModule;

put $r158 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isProducedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isProducedBy",
  has typeLabel "isProducedBy",
  has kind "relation",
  has prefLabel "is produced by",
  has definition "Relates something to the thing that created, composed, or brought it into existence.",
  has example "A deliverable is produces by a task.",
  has example "A measurement is produced by a sensor.",
  has example "A painting is produced by a person.";
put (resource: $r158, module: $gist_core) isa inModule;

put $r159 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isRecognizedBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isRecognizedBy",
  has typeLabel "isRecognizedBy",
  has kind "relation",
  has prefLabel "is recognized by",
  has definition "Relates something to a party that formally acknowledges its existence, validity, or legality.",
  has example "The existence of a particular company is recognized by the state.";
put (resource: $r159, module: $gist_core) isa inModule;

put $r160 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isRenderedOn",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isRenderedOn",
  has typeLabel "isRenderedOn",
  has kind "relation",
  has prefLabel "is rendered on",
  has definition "Relates content to the media on which it is rendered.",
  has example "A document is rendered on a computer screen; a piece of music is rendered through speakers.";
put (resource: $r160, module: $gist_core) isa inModule;

put $r161 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isTriggeredBy",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isTriggeredBy",
  has typeLabel "isTriggeredBy",
  has kind "relation",
  has prefLabel "is triggered by",
  has definition "Relates a contingency, such as an event or obligation, to the event that gives rise to it.",
  has scopeNote "For obligations, this property describes what must happen to trigger the contingent obligation. Other uses include controls, processes, etc.",
  has example "Fire insurance is contingent on a particular building burning down; the death benefit payout on a life insurance policy is contingent on the death of the insured person.";
put (resource: $r161, module: $gist_core) isa inModule;

put $r162 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isUnderJurisdictionOf",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isUnderJurisdictionOf",
  has typeLabel "isUnderJurisdictionOf",
  has kind "relation",
  has prefLabel "is under jurisdiction of",
  has definition "Relates a law, contract, etc., to the system of law or government which has the power, right, or authority to interpret and apply it.";
put (resource: $r162, module: $gist_core) isa inModule;

put $r163 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/links",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/links",
  has typeLabel "linksRel",
  has kind "relation",
  has prefLabel "links",
  has definition "Relates a network link to a network node that it connects to another node. Used when the connection is undirected or the direction is not known.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/NetworkLink";
put (resource: $r163, module: $gist_core) isa inModule;

put $r164 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/linksFrom",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/linksFrom",
  has typeLabel "linksFrom",
  has kind "relation",
  has prefLabel "links from",
  has definition "Relates a network link to its origin network node. Unlike the superproperty, this represents a directed connection.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/NetworkLink";
put (resource: $r164, module: $gist_core) isa inModule;

put $r165 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/linksTo",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/linksTo",
  has typeLabel "linksTo",
  has kind "relation",
  has prefLabel "links to",
  has definition "Relates a network link to its destination network node. Unlike the superproperty, this represents a directed connection.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/NetworkLink";
put (resource: $r165, module: $gist_core) isa inModule;

put $r166 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/occursIn",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/occursIn",
  has typeLabel "occursIn",
  has kind "relation",
  has prefLabel "occurs in",
  has definition "Relates something, such as an event, to the geographic location where it did, does, or will happen.";
put (resource: $r166, module: $gist_core) isa inModule;

put $r167 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/offersToProvide",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/offersToProvide",
  has typeLabel "offersToProvide",
  has kind "relation",
  has prefLabel "offers to provide",
  has definition "Relates an offer to the thing being made available for exchange.",
  has scopeNote "This will most often be a good or service, but could be an amount of money, e.g., for currency exchange.",
  has example "An offer to provide a specific product in exchange for an amount of money or to pay a certain price for a home that is for sale.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Offer";
put (resource: $r167, module: $gist_core) isa inModule;

put $r168 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/offersToReceive",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/offersToReceive",
  has typeLabel "offersToReceive",
  has kind "relation",
  has prefLabel "offers to receive",
  has definition "Relates an offer to the thing expected in return for the offered item.",
  has scopeNote "This will most often be an amount of money, but could be anything of value, as in swaps.",
  has example "A vendor makes an offer to receive a particular amount of money in exchange for the offered product; an offer to receive a home in exchange for an amount of money.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Offer";
put (resource: $r168, module: $gist_core) isa inModule;

put $r169 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/owns",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/owns",
  has typeLabel "ownsRel",
  has kind "relation",
  has prefLabel "owns",
  has definition "Relates a party to something that it possesses and controls.",
  has scopeNote "The ultimate form of ownership is the right to destroy.",
  has scopeNote "There is a long list of potential range classes.";
put (resource: $r169, module: $gist_core) isa inModule;

put $r170 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/precedes",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/precedes",
  has typeLabel "precedes",
  has kind "relation",
  has prefLabel "precedes",
  has definition "A generic ordering relation indicating that the subject comes before the object.",
  has scopeNote "The less-than symbol is often used to represent this relation.",
  has scopeNote "This is the transitive version of gist:precedesDirectly.",
  has scopeNote "Typically this predicate would be used asymmetricallly and irreflexively, but the ontology does not formalize this.";
put (resource: $r170, module: $gist_core) isa inModule;

put $r171 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/precedesDirectly",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/precedesDirectly",
  has typeLabel "precedesDirectly",
  has kind "relation",
  has prefLabel "precedes directly",
  has definition "A generic ordering relation indicating that the subject comes immediately before the object.",
  has scopeNote "If two items in an ordered collection share the same position, they both directly precede the following element.",
  has scopeNote "It is safest to use this property only when the directness has a semantic correspondence with the world. Only break a direct link by inserting an intermediate item when that change corresponds to a change in the world.",
  has scopeNote "Typically this predicate would be used asymmetricallly and irreflexively, but the ontology does not formalize this.";
put (resource: $r171, module: $gist_core) isa inModule;

put $r172 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/prevents",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/prevents",
  has typeLabel "prevents",
  has kind "relation",
  has prefLabel "prevents",
  has definition "Relates an intention to behavior that it prohibits.",
  has example "A city ordinance prohibits jaywalking.";
put (resource: $r172, module: $gist_core) isa inModule;

put $r173 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/providesOrderFor",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/providesOrderFor",
  has typeLabel "providesOrderFor",
  has kind "relation",
  has prefLabel "provides order for",
  has definition "Links a member of an ordered collection to the real-world item it represents in that collection.";
put (resource: $r173, module: $gist_core) isa inModule;

put $r174 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/refersTo",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/refersTo",
  has typeLabel "refersTo",
  has kind "relation",
  has prefLabel "refers to",
  has definition "Relates something to another resource that it points to, indicates, or references.";
put (resource: $r174, module: $gist_core) isa inModule;

put $r175 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/requires",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/requires",
  has typeLabel "requires",
  has kind "relation",
  has prefLabel "requires",
  has definition "The subject needs the object or makes it necessary, mandatory, or compulsory.",
  has scopeNote "This predicate is defined generally enough to encompass a few different meanings of the English word 'requires':\n\n\t\t1. To need something or to make something necessary.\n\t\t2. To order or demand something, or to order someone to do something, especially because of a rule or law.\n\t\t3. To make it officially necessary for someone to do something.\n\n\tImplementations requiring a more specific meaning should define subproperties.",
  has example "Humans require air; solar power requires sunshine.";
put (resource: $r175, module: $gist_core) isa inModule;

put $r176 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDate",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDate",
  has typeLabel "actualEndDate",
  has kind "attribute",
  has prefLabel "actual end date",
  has definition "The actual date that something ended, with precision of one day.",
  has scopeNote "Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.",
  has example "'2021-06-01T00:00:00-6:00'^^xsd:dateTime";
put (resource: $r176, module: $gist_core) isa inModule;

put $r177 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime",
  has typeLabel "actualEndDateTime",
  has kind "attribute",
  has prefLabel "actual end date time",
  has definition "The actual date and time that something ended, with no implied precision.",
  has scopeNote "This is an abstraction over the various precisions of actual end time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.";
put (resource: $r177, module: $gist_core) isa inModule;

put $r178 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMicrosecond",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMicrosecond",
  has typeLabel "actualEndMicrosecond",
  has kind "attribute",
  has prefLabel "actual end microsecond",
  has definition "The actual time that something ended, expressed as a system time used for timestamps.",
  has scopeNote "A system time will be as precise as the system can supply, typically at least milliseconds, sometimes microseconds. The convention for timestamps, such as recording a transaction, is to specify just the end point; the start time is rarely needed.",
  has example "'2021-06-01T08:03:27.12324-6:00'^^xsd:dateTime";
put (resource: $r178, module: $gist_core) isa inModule;

put $r179 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMinute",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMinute",
  has typeLabel "actualEndMinute",
  has kind "attribute",
  has prefLabel "actual end minute",
  has definition "The actual date and time that something ended, with precision of one minute.",
  has scopeNote "Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.",
  has example "'2021-06-01T08:32:00-6:00'^^xsd:dateTime";
put (resource: $r179, module: $gist_core) isa inModule;

put $r180 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualEndYear",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndYear",
  has typeLabel "actualEndYear",
  has kind "attribute",
  has prefLabel "actual end year",
  has definition "The actual date that something ended, with precision of one year.",
  has scopeNote "Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.",
  has example "'2021-01-01T00:00:00-6:00'^^xsd:dateTime",
  has example "The tenure of the previous chairman of the board ended in 2021.";
put (resource: $r180, module: $gist_core) isa inModule;

put $r181 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualStartDate",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualStartDate",
  has typeLabel "actualStartDate",
  has kind "attribute",
  has prefLabel "actual start date",
  has definition "The actual date that something started, with precision of one day.",
  has scopeNote "Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.",
  has example "'2021-06-01T00:00:00-6:00'^^xsd:dateTime";
put (resource: $r181, module: $gist_core) isa inModule;

put $r182 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime",
  has typeLabel "actualStartDateTime",
  has kind "attribute",
  has prefLabel "actual start date time",
  has definition "The actual date and time that something started, with no implied precision.",
  has scopeNote "This is an abstraction over the various precisions of actual start time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.";
put (resource: $r182, module: $gist_core) isa inModule;

put $r183 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualStartMicrosecond",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualStartMicrosecond",
  has typeLabel "actualStartMicrosecond",
  has kind "attribute",
  has prefLabel "actual start microsecond",
  has definition "The actual time that something started, expressed as a system time used for timestamps.",
  has scopeNote "A system time will be as precise as the system can supply, typically at least milliseconds, sometimes microseconds. The convention for timestamps, such as recording a transaction, is to specify just the end point; the start time is rarely needed. This property is defined for the cases when you do need to capture the runtime of a system process, and is then used in conjunction with gist:actualEndMicrosecond.",
  has example "'2021-06-01T08:03:27.12324-6:00'^^xsd:dateTime";
put (resource: $r183, module: $gist_core) isa inModule;

put $r184 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualStartMinute",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualStartMinute",
  has typeLabel "actualStartMinute",
  has kind "attribute",
  has prefLabel "actual start minute",
  has definition "The actual date and time that something started, with precision of one minute.",
  has scopeNote "Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.",
  has example "'2021-06-01T08:32:00-6:00'^^xsd:dateTime";
put (resource: $r184, module: $gist_core) isa inModule;

put $r185 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/actualStartYear",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/actualStartYear",
  has typeLabel "actualStartYear",
  has kind "attribute",
  has prefLabel "actual start year",
  has definition "The actual date that something started, with precision of one year.",
  has scopeNote "Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.",
  has example "'2021-01-01T00:00:00-6:00'^^xsd:dateTime",
  has example "The tenure of the current chairman of the board began in 2021.";
put (resource: $r185, module: $gist_core) isa inModule;

put $r186 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/atDateTime",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/atDateTime",
  has typeLabel "atDateTime",
  has kind "attribute",
  has prefLabel "at date time",
  has definition "The date and time at which something did or will occur, with variants for precision, start and end, and actual vs. planned.",
  has scopeNote "This is the top level property for asserting time, and is not expected to be asserted directly.\n\nThe subproperties allow the ontologist to do three things:\n1) Distinguish start and end times.\n2) Indicate whether a time is planned or actual. This is useful for everything from project management to calendar appointments and the like. It is also useful for date effectivities; i.e., something valid up to a planned date).\n3) Distinguish varying levels of precision; sort of a simple version of the Allen functions.\n\nAll datetimes are of the same format: '2021-06-01T08:03:27.12324-6:00'^^xsd:dateTime. This is compatible with and a subset of ISO 8601.\n\nTime zone offset, such as -6:00 (of which there are a few dozen) is recognized in the date itself, as shown. The actual time zone standard (of which there are 131) may optionally be attached to the event or other object itself.\n\nThere will be many historical dates that do not have a time zone offset (e.g., Lincoln's birthday, as well as about 75% of all legacy systems), and in that case the offset can be omitted.\n\nThe conventions for precision that are repeated in each property name are as follows:\n\t- *DateTime is an abstraction over the various precisions of its subproperties.\n\t- *Date refers to a calendar date (e.g., birthdays and invoice dates) and is assumed to have precision of one day. Time zone offset is allowed.\n\t- *Minute refers to clock time; e.g., a meeting will start at 9:15 with a timezone offset. Precision is assumed to have precision of one minute.\n\t- *Microsecond refers to system time, and it will be as precise as the system can supply; typically at least milliseconds, sometime microseconds.\n";
put (resource: $r186, module: $gist_core) isa inModule;

put $r187 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/birthDate",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/birthDate",
  has typeLabel "birthDate",
  has kind "attribute",
  has prefLabel "birth date",
  has definition "The date some living thing was or will be born, with precision of one day.",
  has scopeNote "This is a subproperty of gist:startDateTime rather than gist:actualStartDate because some living things have yet to be born. This property refers to a calendar date and is assumed to precision of one day (time zone offset is allowed). It is recommended to zero out the hours through microseconds to avoid spurious precision. Implementations requiring a birthdate to the minute can define a subproperty.",
  has example "'2021-06-01T00:00:00-6:00'^^xsd:dateTime";
put (resource: $r187, module: $gist_core) isa inModule;

put $r188 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/containedText",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/containedText",
  has typeLabel "containedText",
  has kind "attribute",
  has prefLabel "contained text",
  has definition "A string that is closely associated with an individual.",
  has example "The string associated with a tag or with text content.",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Tag",
  has domainIncludes "https://w3id.org/semanticarts/ns/ontology/gist/Text";
put (resource: $r188, module: $gist_core) isa inModule;

put $r189 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/conversionFactor",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/conversionFactor",
  has typeLabel "conversionFactor",
  has kind "attribute",
  has prefLabel "conversion factor",
  has definition "A value that relates a unit of measure to units of the International System of Units.",
  has scopeNote "To convert a numeric value from one unit of measure to another, multiply by the conversion factor of the first unit and then divide by the conversion factor of the second unit.\n\n\tFor example, to convert 27 feet to yards:\n\n\t\tthe conversion factor of foot is 0.3048\n\t\tthe conversion factor of yard is 0.9144\n\n\t\tso\n\n\t\t27 feet = (27 x 0.3048) / 0.9144 = 9 yards",
  has example "In the equation 1 inch = 0.0254 meters, the value 0.0254 is the conversion factor of inch.",
  has seeAlso "https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset";
put (resource: $r189, module: $gist_core) isa inModule;

put $r190 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset",
  has typeLabel "conversionOffset",
  has kind "attribute",
  has prefLabel "conversion offset",
  has definition "\n\t\tA value used along with a conversion factor to relate a unit to its corresponding unit in the International System of Units. In the equation below, the conversion offset is 459.669607 and the conversion factor is 5/9.\n\n\t\ty degrees Fahrenheit = (y + 459.669607) x 5/9 degrees Kelvin\n\n\t\tTo convert from Fahrenheit to Kelvin, first add the offset and then multiply by the conversion factor.\n\n\t\tTo convert from Kelvin to Fahrenheit, reverse the steps: first divide by the conversion factor and then subtract the offset.";
put (resource: $r190, module: $gist_core) isa inModule;

put $r191 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/deathDate",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/deathDate",
  has typeLabel "deathDate",
  has kind "attribute",
  has prefLabel "death date",
  has definition "The date some living thing died.",
  has scopeNote "Refers to a calendar date and is assumed to have precision of one day (time zone offset is allowed). Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Implementations requiring a death date to the minute can define a subproperty.",
  has example "'2021-06-01T00:00:00-6:00'^^xsd:dateTime";
put (resource: $r191, module: $gist_core) isa inModule;

put $r192 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/description",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/description",
  has typeLabel "description",
  has kind "attribute",
  has prefLabel "description",
  has definition "A statement about someone or something's attributes or characteristics.",
  has scopeNote "This property is used to describe instance data which is not part of the ontology. A definition and a description have different semantics. Use skos:definition for a statement of the meaning of a thing and gist:description to describe a thing's attributes, characteristics, or features.",
  has example "'The Empire State Building is a 102-story Art Deco skyscraper in midtown Manhattan in New York City. It was designed by Shreve, Lamb & Harmon and built from 1930 to 1931.'",
  has example "A person does not have a definition, but might be described as being six feet tall with brown hair and blue eyes; an ontology class or taxonomy term has a definition.";
put (resource: $r192, module: $gist_core) isa inModule;

put $r193 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/encryptedText",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/encryptedText",
  has typeLabel "encryptedText",
  has kind "attribute",
  has prefLabel "encrypted text",
  has definition "Encoded text produced from readable data by an algorithm so that it can only be understood or restored with a decryption key.";
put (resource: $r193, module: $gist_core) isa inModule;

put $r194 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/endDateTime",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/endDateTime",
  has typeLabel "endDateTime",
  has kind "attribute",
  has prefLabel "end date time",
  has definition "The date and time that something ends.",
  has scopeNote "This property is neutral along two dimensions: precision (e.g., day, second, millisecond) and actual vs. planned. As such, it will generally not be asserted directly except in special cases (e.g., for time intervals).",
  has scopeNote "Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.";
put (resource: $r194, module: $gist_core) isa inModule;

put $r195 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfAmpere",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfAmpere",
  has typeLabel "exponentOfAmpere",
  has kind "attribute",
  has prefLabel "exponent of ampere",
  has definition "The exponent of ampere in a product of powers of base units.",
  has example "In the equation '1 milliampere = 0.001 x ampere'\n\n\t\tthe conversionFactor for milliampere is 0.001\n\t\tthe exponent of ampere is 1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing milliampere must be a multiple of ampere.";
put (resource: $r195, module: $gist_core) isa inModule;

put $r196 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfBit",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfBit",
  has typeLabel "exponentOfBit",
  has kind "attribute",
  has prefLabel "exponent of bit",
  has definition "The exponent of bit in a product of powers of base units.",
  has example "In the equation '1 megabit per second = 1000000 x bit per second'\n\n\t\tthe conversion factor for megabit per second is 1000000\n\t\tthe exponent of bit is 1\n\t\tthe exponent of second is -1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing megabit per second must be a multiple of bit per second.";
put (resource: $r196, module: $gist_core) isa inModule;

put $r197 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfCandela",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfCandela",
  has typeLabel "exponentOfCandela",
  has kind "attribute",
  has prefLabel "exponent of candela",
  has definition "The exponent of candela in a product of powers of base units.",
  has example "In the equation '1 candlepower = 1 x candela'\n\n\t\tthe conversion factor for candlepower is 1\n\t\tthe exponent of candela is 1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing candlepower must be a multiple of candela.";
put (resource: $r197, module: $gist_core) isa inModule;

put $r198 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfKelvin",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfKelvin",
  has typeLabel "exponentOfKelvin",
  has kind "attribute",
  has prefLabel "exponent of Kelvin",
  has definition "The exponent of Kelvin in a product of powers of base units.",
  has example "In the equation 'y degrees Fahrenheit = (y + 459.6669607) x 5/9 degrees Kelvin'\n\n\t\tthe conversion offset for degree Fahrenheit is 459.6669607\n\t\tthe conversion factor for degree Fahrenheit is 5/9\n\t\tthe exponent of Kelvin is 1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing degree Fahrenheit will have a similar equation, with different offset or conversion factor (or both).";
put (resource: $r198, module: $gist_core) isa inModule;

put $r199 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfKilogram",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfKilogram",
  has typeLabel "exponentOfKilogram",
  has kind "attribute",
  has prefLabel "exponent of kilogram",
  has definition "The exponent of kilogram in a product of powers of base units.",
  has example "In the equation '1 millimole per gram = 1 x mole per kilogram'\n\n\t\tthe conversion factor for millimole per gram is 1\n\t\tthe exponent of mole is 1\n\t\tthe exponent of kilogram is -1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing millimole per gram must be a multiple of mole per kilogram.";
put (resource: $r199, module: $gist_core) isa inModule;

put $r200 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfMeter",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfMeter",
  has typeLabel "exponentOfMeter",
  has kind "attribute",
  has prefLabel "exponent of meter",
  has definition "The exponent of meter in a product of powers of base units.",
  has example "In the equation '1 microgram per milliliter = 0.001 x kilogram per meterCubed'\n\n\t\tthe conversion factor for microgram per milliliter is 0.001\n\t\tthe exponent of kilogram is 1\n\t\tthe exponent of meter is -3\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing microgram per milliliter must be a multiple of kilogram per meterCubed.";
put (resource: $r200, module: $gist_core) isa inModule;

put $r201 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfMole",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfMole",
  has typeLabel "exponentOfMole",
  has kind "attribute",
  has prefLabel "exponent of mole",
  has definition "The exponent of mole in a product of powers of base units.",
  has example "In the equation '1 katal = 1 x mole per second'\n\n\t\tthe conversion factor for katal is 1\n\t\tthe exponent of mole is 1\n\t\tthe exponent of second is -1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing katal must be a multiple of mole per second.";
put (resource: $r201, module: $gist_core) isa inModule;

put $r202 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfNumber",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfNumber",
  has typeLabel "exponentOfNumber",
  has kind "attribute",
  has prefLabel "exponent of number",
  has definition "The exponent of number in a product of powers of base units.",
  has scopeNote "Use when the unit of measure involves a count or other number.",
  has example "In the equation '1 beat per minute = 0.016667 x number per second'\n\n\t\tthe conversion factor for beat per minute is 0.016667\n\t\tthe exponent of number is 1\n\t\tthe exponent of second is -1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing beat per minute must be a multiple of number per second.";
put (resource: $r202, module: $gist_core) isa inModule;

put $r203 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfOther",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfOther",
  has typeLabel "exponentOfOther",
  has kind "attribute",
  has prefLabel "exponent of other",
  has definition "Indicates whether a unit of measure can be expressed in terms of the standard exponents (as shown in the examples).",
  has scopeNote "Set the value to 0 if the units of measure in the unit group can be expressed using the standard set of exponents (as in the examples).\n\n\t\tOtherwise set the value to 1, which typically means the units of measure in the group use a logarithmic scale.",
  has example "Decibel, pH, and octave are units of measure that are logarithmic. Their unit groups have exponent of other = 1.";
put (resource: $r203, module: $gist_core) isa inModule;

put $r204 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfRadian",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfRadian",
  has typeLabel "exponentOfRadian",
  has kind "attribute",
  has prefLabel "exponent of radian",
  has definition "The exponent of radian in a product of powers of base units.",
  has example "In the equation '1 revolution = 6.283 x radian'\n\n\t\tthe conversion factor for revolution is 6.283\n\t\tthe exponent of radian is 1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing revolution must be a multiple of radian.";
put (resource: $r204, module: $gist_core) isa inModule;

put $r205 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfSecond",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfSecond",
  has typeLabel "exponentOfSecond",
  has kind "attribute",
  has prefLabel "exponent of second",
  has definition "The exponent of second in a product of powers of base units.",
  has example "In the equation '1 watt-hour = 3600 x kilogram meterSquared per secondSquared'\n\n\t\tthe conversion factor for watt-hour is 3600\n\t\tthe exponent of kilogram is 1\n\t\tthe exponent of meter is 2\n\t\tthe exponent of second is -2\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing watt-hour must be a multiple of kilogram meterSquared per secondSquared.";
put (resource: $r205, module: $gist_core) isa inModule;

put $r206 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfSteradian",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfSteradian",
  has typeLabel "exponentOfSteradian",
  has kind "attribute",
  has prefLabel "exponent of steradian",
  has definition "The exponent of steradian in a product of powers of base units.",
  has scopeNote "Steradian is a measure of solid angle.",
  has example "In the equation '1 watt per square meter steradian = 1 x kilogram per secondCubed steradian'\n\n\t\tthe conversion factor for watt per square meter steradian is 1\n\t\tthe exponent of kilogram is 1\n\t\tthe exponent of second is -3\n\t\tthe exponent of steradian is -1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing watt per square meter steradian must a multiple of kilogram per secondCubed steradian.";
put (resource: $r206, module: $gist_core) isa inModule;

put $r207 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfUSDollar",
