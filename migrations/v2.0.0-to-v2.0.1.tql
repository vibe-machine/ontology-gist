# Migration: ontology-gist v2.0.0 -> v2.0.1
# Generated for schema-doc structural metadata refresh
# Apply in a write transaction against an existing database
# manifest: manifests/gist-v2.0.1.translation-manifest.json

match
  $module isa SchemaModule, has moduleKey "gist-core";
  $link isa inModule (resource: $resource, module: $module);
delete
  $link;
  $resource;

match
  $module isa SchemaModule, has moduleKey "gist-core";
delete
  $module;

