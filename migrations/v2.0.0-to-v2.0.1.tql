  has typeLabel "exponentOfUSDollar",
  has kind "attribute",
  has prefLabel "exponent of US dollar",
  has definition "The exponent of US Dollar in a product of powers of base units.",
  has scopeNote "The factors for converting from one currency to another change constantly.",
  has example "In the equation '1 million dollars per week = 1.65344 x dollar per second'\n\n\t\tthe conversion factor for million dollars per week is 1.65344\n\t\tthe exponent of US Dollar is 1\n\t\tthe exponent of second is -1\n\t\tall other exponents are zero\n\n\t\tEvery member of a unit group containing million dollars per week must be a multiple of dollar per second.";
put (resource: $r207, module: $gist_core) isa inModule;

put $r208 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/idText",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/idText",
  has typeLabel "idText",
  has kind "attribute",
  has prefLabel "id text",
  has definition "A text string that identifies an individual.",
  has scopeNote "A common use case would be for pre-existing internal company identifiers.",
  has scopeNote "Often, there will be just one identifying text string. More would be appropriate if the individual had different identifiers, such as employee number and social security number. A good way to model that would be to have functional subproperties of idText, such as departmentNumber.",
  has scopeNote "This property is an alternative to using the property gist:isIdentifiedBy in conjunction with instances of the class gist:ID.",
  has example "The id text for a car is '4Y1SL65848Z411439'; the id text for the HR department of some company is H31415.";
put (resource: $r208, module: $gist_core) isa inModule;

put $r209 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/isRecordedAt",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/isRecordedAt",
  has typeLabel "isRecordedAt",
  has kind "attribute",
  has prefLabel "is recorded at",
  has definition "The date that something was posted (which is not necessarily the date it occurred). It must be after the date of occurrence, but could be before or after the planned date.",
  has scopeNote "Precision may vary according to context.",
  has example "The date and time a customer payment or stock purchase was posted.";
put (resource: $r209, module: $gist_core) isa inModule;

