put $r223 isa SchemaResource,
  has docKey "https://w3id.org/semanticarts/ns/ontology/gist/startDateTime",
  has iri "https://w3id.org/semanticarts/ns/ontology/gist/startDateTime",
  has typeLabel "startDateTime",
  has kind "attribute",
  has prefLabel "start date time",
  has definition "The date and time that something starts.",
  has scopeNote "This property is neutral along two dimensions: precision (e.g., day, second, millisecond) and actual vs. planned. As such, it will generally not be asserted directly except in special cases (e.g., for time intervals).",
  has scopeNote "Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.";
