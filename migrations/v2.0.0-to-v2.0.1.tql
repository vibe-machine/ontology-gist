  has kind "entity",
  has prefLabel "Schema Resource",
  has definition "A queryable documentation record for a schema type, role, or related resource.",
  has scopeNote "The schema browser combines SchemaResource documentation with structural metadata relations.";
put (resource: $r4, module: $gist_core) isa inModule;

put $r5 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#roleName",
  has iri "https://vibe-machine.github.io/schema/self-describing#roleName",
  has typeLabel "roleName",
  has kind "attribute",
  has prefLabel "role name",
  has definition "The local role label for a role SchemaResource.";
put (resource: $r5, module: $gist_core) isa inModule;

put $r6 isa SchemaResource,
