put $gist_core isa SchemaModule,
  has moduleKey "gist-core",
  has moduleName "gistCore",
  has moduleKind "gist-core";

put $r1 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#SchemaModule",
  has iri "https://vibe-machine.github.io/schema/self-describing#SchemaModule",
  has typeLabel "SchemaModule",
  has kind "entity",
  has prefLabel "Schema Module",
  has definition "A named ontology module installed in the live database.",
  has scopeNote "Used to organize SchemaResource records by package or ontology layer.";
put (resource: $r1, module: $gist_core) isa inModule;

put $r2 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#SchemaView",
  has iri "https://vibe-machine.github.io/schema/self-describing#SchemaView",
  has typeLabel "SchemaView",
  has kind "entity",
  has prefLabel "Schema View",
  has definition "A named organizational perspective for browsing or presenting documented schema resources.",
  has scopeNote "Examples include Domain View, Workflow View, and Ontology View.";
put (resource: $r2, module: $gist_core) isa inModule;

put $r3 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#SchemaGroup",
  has iri "https://vibe-machine.github.io/schema/self-describing#SchemaGroup",
  has typeLabel "SchemaGroup",
  has kind "entity",
  has prefLabel "Schema Group",
  has definition "A named grouping of documented schema resources within a particular schema view.",
  has scopeNote "A schema resource may appear in multiple schema groups across different views.";
put (resource: $r3, module: $gist_core) isa inModule;

put $r4 isa SchemaResource,
  has docKey "https://vibe-machine.github.io/schema/self-describing#SchemaResource",
  has iri "https://vibe-machine.github.io/schema/self-describing#SchemaResource",
